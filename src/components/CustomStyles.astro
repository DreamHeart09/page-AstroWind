---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(6 182 212);
    --aw-color-secondary: rgb(14 116 144);
    --aw-color-accent: rgb(34 211 238);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(30 41 59);
    --aw-color-text-muted: rgb(71 85 105);
    --aw-color-bg-page: rgb(248 250 252);

    --aw-color-bg-page-dark: rgb(15 23 42);

    ::selection {
      background-color: rgb(6 182 212 / 30%);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(34 211 238);
    --aw-color-secondary: rgb(6 182 212);
    --aw-color-accent: rgb(56 189 248);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(168 181  198);
    --aw-color-bg-page: rgb(15 23 42);

    ::selection {
      background-color: rgb(6 182 212 / 40%);
      color: white;
    }
  }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .dark h1,
  .dark h2,
  .dark h3,
  .dark h4,
  .dark h5,
  .dark h6 {
    color: rgb(248 250 252);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .dark p,
  .dark li,
  .dark span:not(.text-cyan-400):not(.text-cyan-300) {
    color: rgb(226 232 240);
  }

  .dark .text-muted,
  .dark .text-gray-600 {
    color: rgb(168 181 198) !important;
  }

  .dark .text-gray-400 {
    color: rgb(148 163 184) !important;
  }

  .dark .bg-white\/60 {
    background-color: rgba(30, 41, 59, 0.8) !important;
  }

  .dark .border-slate-700 {
    border-color: rgba(71, 85, 105, 0.5) !important;
  }

  .dark .text-gray-900 {
    color: rgb(248 250 252) !important;
  }

  .dark .text-gray-700 {
    color: rgb(226 232 240) !important;
  }

  .dark .prose {
    color: rgb(226 232 240);
  }

  .dark .prose h1,
  .dark .prose h2,
  .dark .prose h3,
  .dark .prose h4 {
    color: rgb(248 250 252);
  }

  .dark .prose p,
  .dark .prose li {
    color: rgb(226 232 240);
  }

  .dark .prose code {
    background-color: rgba(30, 41, 59, 0.8);
    color: rgb(34 211 238);
  }

  .dark .prose a {
    color: rgb(34 211 238);
  }

  .dark .prose a:hover {
    color: rgb(56 189 248);
  }
</style>
