---
import { SITE } from 'astrowind:config';
import { Image } from 'astro:assets';
---

<div class="flex items-center gap-2">
  <div class="w-8 h-8 md:w-9 md:h-9 rounded-lg overflow-hidden flex items-center justify-center">
    <img src="/logo.png" alt="Logo" class="w-full h-full object-cover" />
  </div>
  <div class="flex flex-col leading-tight">
    <span class="text-lg md:text-xl font-bold text-gray-900 dark:text-white tracking-tight">
      {SITE?.name}
    </span>
    <span class="text-[10px] md:text-xs text-gray-500 dark:text-gray-400 font-medium tracking-wide">
      Eversec 恒安嘉新
    </span>
  </div>
</div>
