---
import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AIGov Insight — AI 世界的全息沙盘',
  ignoreTitleTemplate: true,
};

const base = import.meta.env.BASE_URL;
---

<Layout metadata={metadata}>
  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-30px) rotate(2deg); }
    }
    @keyframes pulse-glow {
      0%, 100% { opacity: 0.4; transform: scale(1); filter: blur(60px); }
      50% { opacity: 0.7; transform: scale(1.1); filter: blur(80px); }
    }
    @keyframes gradient-shift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }
    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scale-in {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes breathe {
      0%, 100% { transform: scale(1); opacity: 0.5; }
      50% { transform: scale(1.05); opacity: 0.7; }
    }
    .animate-float { animation: float 8s ease-in-out infinite; }
    .animate-pulse-glow { animation: pulse-glow 6s ease-in-out infinite; }
    .animate-gradient { background-size: 200% 200%; animation: gradient-shift 8s ease infinite; }
    .animate-fade-in-up { animation: fade-in-up 0.8s ease-out forwards; }
    .animate-scale-in { animation: scale-in 0.6s ease-out forwards; }
    .animate-breathe { animation: breathe 4s ease-in-out infinite; }

    .text-gradient {
      background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 50%, #14b8a6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-badge {
      background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(248,250,252,0.8) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    :global(.dark) .hero-badge {
      background: linear-gradient(135deg, rgba(30,41,59,0.8) 0%, rgba(15,23,42,0.6) 100%);
    }
    .hero-button-primary {
      background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 50%, #14b8a6 100%);
      background-size: 200% 200%;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-button-primary:hover {
      background-position: 100% 50%;
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(59,130,246,0.4);
    }
    .hero-button-secondary {
      background: rgba(255,255,255,0.8);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.dark) .hero-button-secondary {
      background: linear-gradient(135deg, rgba(30,41,59,0.7) 0%, rgba(15,23,42,0.5) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(6,182,212,0.2);
      box-shadow: 0 4px 24px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.05);
    }
    .hero-button-secondary:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(0,0,0,0.15);
    }
    :global(.dark) .hero-button-secondary:hover {
      background: linear-gradient(135deg, rgba(30,41,59,0.85) 0%, rgba(15,23,42,0.7) 100%);
      border-color: rgba(6,182,212,0.4);
      box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 0 40px rgba(6,182,212,0.15), inset 0 1px 0 rgba(255,255,255,0.08);
    }
    .glow-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      animation: breathe 6s ease-in-out infinite;
    }

    .product-card {
      position: relative;
      border-radius: 1.5rem;
      overflow: hidden;
      padding: 2.5rem;
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .product-card:hover { transform: translateY(-4px); }

    .tech-card {
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255,255,255,0.5);
      border-radius: 1.25rem;
      padding: 2rem;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.dark) .tech-card {
      background: rgba(15,23,42,0.5);
      border-color: rgba(255,255,255,0.06);
    }
    .tech-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 60px -12px rgba(0,0,0,0.12);
    }
    :global(.dark) .tech-card:hover {
      box-shadow: 0 20px 60px -12px rgba(0,0,0,0.4);
    }

    .metric-card {
      text-align: center;
      padding: 1.5rem 1rem;
      border-radius: 1rem;
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.5);
    }
    :global(.dark) .metric-card {
      background: rgba(15,23,42,0.5);
      border-color: rgba(255,255,255,0.06);
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-float, .animate-pulse-glow, .animate-gradient,
      .animate-fade-in-up, .animate-scale-in, .animate-breathe {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>

  <!-- ═══ HERO ═══ -->
  <section class="relative pt-24 pb-20 md:pt-36 md:pb-32 lg:pt-44 lg:pb-40 overflow-visible">
    <div class="absolute inset-0 pointer-events-none overflow-visible">
      <div class="glow-orb w-[700px] h-[700px] -top-40 left-1/4 bg-gradient-to-br from-blue-200/50 via-cyan-100/30 to-transparent dark:from-blue-600/20 dark:via-cyan-500/10"></div>
      <div class="glow-orb w-[600px] h-[600px] top-1/3 -right-20 bg-gradient-to-bl from-cyan-200/40 via-teal-100/20 to-transparent dark:from-cyan-600/15 dark:via-teal-500/8" style="animation-delay: 2s;"></div>
      <div class="glow-orb w-[500px] h-[500px] -bottom-20 left-1/3 bg-gradient-to-tr from-teal-200/30 via-emerald-100/15 to-transparent dark:from-teal-600/10 dark:via-emerald-500/5" style="animation-delay: 4s;"></div>
      <div class="absolute top-20 left-10 w-2 h-2 rounded-full bg-blue-400/60 dark:bg-blue-500/40 animate-pulse"></div>
      <div class="absolute top-40 right-20 w-1.5 h-1.5 rounded-full bg-cyan-400/60 dark:bg-cyan-500/40 animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute bottom-32 left-1/4 w-1 h-1 rounded-full bg-teal-400/60 dark:bg-teal-500/40 animate-pulse" style="animation-delay: 2s;"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="animate-fade-in-up opacity-0" style="animation-delay: 0.1s;">
        <div class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full hero-badge border border-blue-100/80 dark:border-cyan-800/50 mb-10 md:mb-14 shadow-lg shadow-blue-500/5 dark:shadow-cyan-500/5">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gradient-to-r from-blue-400 to-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gradient-to-r from-blue-500 to-cyan-500"></span>
          </span>
          <span class="text-sm font-semibold tracking-[0.15em] text-gradient uppercase">Eversec AI Governance Insight</span>
        </div>
      </div>

      <h1 class="animate-fade-in-up opacity-0 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight dark:text-white mb-6 md:mb-8 leading-[1.1]" style="animation-delay: 0.2s;">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-400 to-purple-500 bg-[length:200%_auto] animate-gradient">AI 世界的「全息沙盘」</span>
      </h1>

      <p class="animate-fade-in-up opacity-0 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight dark:text-white mb-8 md:mb-12 leading-tight" style="animation-delay: 0.3s;">
        让 AI 的每一次"思考"与"行动"<br class="hidden sm:block" />
        <span class="text-slate-500 dark:text-slate-400 font-normal">全程透明、可溯、可控</span>
      </p>

      <p class="animate-fade-in-up opacity-0 text-lg md:text-xl lg:text-2xl text-slate-500 dark:text-slate-400 max-w-4xl mx-auto leading-relaxed mb-12 md:mb-16" style="animation-delay: 0.4s;">
        <span class="font-semibold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-400 to-purple-500 bg-[length:200%_auto] animate-gradient">AIGov Insight</span> 是恒安嘉新打造的全球领先 AI 自主智能体全链路可观测平台<br class="hidden md:block" />
        覆盖 <span class="font-medium text-slate-700 dark:text-slate-300">LLM / Agent / MCP / RAG / OpenClaw</span> 全场景
      </p>

      <div class="animate-fade-in-up opacity-0 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto mb-12 md:mb-16" style="animation-delay: 0.5s;">
        <div class="metric-card">
          <div class="text-2xl md:text-3xl font-bold text-gradient mb-1">40+</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">AI 模型</div>
        </div>
        <div class="metric-card">
          <div class="text-2xl md:text-3xl font-bold text-gradient mb-1">3</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">Agent 平台</div>
        </div>
        <div class="metric-card">
          <div class="text-2xl md:text-3xl font-bold text-gradient mb-1">100%</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">Local-first</div>
        </div>
        <div class="metric-card">
          <div class="text-2xl md:text-3xl font-bold text-gradient mb-1">0</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">Cloud calls</div>
        </div>
      </div>

      <div class="animate-fade-in-up opacity-0 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5" style="animation-delay: 0.6s;">
        <a href="#products" class="hero-button-primary inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-white font-semibold text-lg shadow-xl shadow-blue-500/25">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          探索产品
        </a>
        <a href="https://github.com/Eversec-ai/AIGov-Insight-Web" target="_blank" class="hero-button-secondary inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-slate-700 dark:text-slate-200 font-semibold text-lg border border-slate-200/80 dark:border-slate-700/50">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ PRODUCTS ═══ -->
  <section id="products" class="py-24 md:py-32 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <p class="text-sm font-medium text-blue-600 dark:text-blue-400 tracking-[0.2em] uppercase mb-4">Products</p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight">选择适合你的方案</h2>
        <p class="text-xl text-gray-500 dark:text-gray-400 max-w-3xl mx-auto font-light">从服务器到桌面，从安全引擎到插件生态——全场景 AI 治理覆盖</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-8">
        <a href={`${base}web`} class="product-card group bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:shadow-2xl hover:shadow-blue-500/10 hover:border-blue-300 dark:hover:border-blue-600/40">
          <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-bl from-blue-500/5 to-transparent rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center shadow-lg shadow-blue-500/20">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z"/></svg>
              </div>
              <span class="text-xs font-semibold tracking-[0.1em] uppercase text-blue-600 dark:text-blue-400">Server · Production</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3 tracking-tight">AIGov Insight <span class="text-blue-500">WEB / Agent</span></h3>
            <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-6">基于 eBPF 内核探针的生产级 AI 可观测平台。Web 端可视化分析 + Agent 端深度采集，专为 Linux 服务器环境打造。</p>
            <div class="flex flex-wrap gap-2 mb-6">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">eBPF</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">Linux</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">生产环境</span>
            </div>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 dark:text-blue-400 group-hover:gap-2.5 transition-all">了解更多 <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </div>
        </a>

        <a href={`${base}edge`} class="product-card group bg-slate-50 dark:bg-[#0a0a0f] border border-slate-200 dark:border-slate-800 hover:shadow-2xl hover:shadow-indigo-500/10 hover:border-indigo-300 dark:hover:border-indigo-500/40">
          <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-bl from-indigo-500/5 to-transparent rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25"/></svg>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold tracking-[0.1em] uppercase text-indigo-600 dark:text-indigo-400">Desktop · Developer</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-gradient-to-r from-violet-500 to-purple-500 text-white">NEW</span>
              </div>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3 tracking-tight">AIGov Insight <span class="bg-gradient-to-r from-indigo-500 to-purple-500 bg-clip-text text-transparent">Edge</span></h3>
            <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-6">macOS 端侧 AI 可观测平台。AI Copilot 驱动 GUI 操控，100% 本地运行，支持 OpenClaw、Hermes、Claude Code 插件生态。</p>
            <div class="flex flex-wrap gap-2 mb-6">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400">AI Copilot</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400">macOS</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400">本地优先</span>
            </div>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 dark:text-indigo-400 group-hover:gap-2.5 transition-all">了解更多 <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </div>
        </a>

        <a href="#openclaw-brief" class="product-card group bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:shadow-2xl hover:shadow-cyan-500/10 hover:border-cyan-300 dark:hover:border-cyan-600/40">
          <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-bl from-cyan-500/5 to-transparent rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-500 to-teal-500 flex items-center justify-center shadow-lg shadow-cyan-500/20">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
              </div>
              <span class="text-xs font-semibold tracking-[0.1em] uppercase text-cyan-600 dark:text-cyan-400">Security Engine</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3 tracking-tight"><span class="text-cyan-500">OpenClaw</span> 安全引擎</h3>
            <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-6">AI Agent 安全治理引擎。拦截、确认、告警三种模式，实时防护 AI Agent 的每一次工具调用和系统命令执行。</p>
            <div class="flex flex-wrap gap-2 mb-6">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-cyan-50 dark:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400">安全防护</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-cyan-50 dark:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400">实时拦截</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-cyan-50 dark:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400">规则引擎</span>
            </div>
