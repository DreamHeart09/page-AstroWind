---
import Layout from '~/layouts/PageLayout.astro';

import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AIGov Insight WEB / Agent — eBPF 生产级 AI 可观测平台',
  description: '基于 eBPF 内核探针的生产级 AI 可观测平台。Web 端可视化分析 + Agent 端深度采集，专为 Linux 服务器环境打造。',
};

const base = import.meta.env.BASE_URL;
---

<Layout metadata={metadata}>
  <style>
    @keyframes float {
      0%,
      100% {
        transform: translateY(0px) rotate(0deg);
      }
      50% {
        transform: translateY(-30px) rotate(2deg);
      }
    }
    @keyframes pulse-glow {
      0%,
      100% {
        opacity: 0.4;
        transform: scale(1);
        filter: blur(60px);
      }
      50% {
        opacity: 0.7;
        transform: scale(1.1);
        filter: blur(80px);
      }
    }
    @keyframes gradient-shift {
      0%,
      100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }
    @keyframes shimmer {
      0% {
        transform: translateX(-100%);
      }
      100% {
        transform: translateX(100%);
      }
    }
    @keyframes fade-in-up {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes scale-in {
      from {
        opacity: 0;
        transform: scale(0.95);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
    @keyframes pulse-ring {
      0% {
        transform: scale(1);
        opacity: 0.8;
      }
      100% {
        transform: scale(1.5);
        opacity: 0;
      }
    }
    @keyframes breathe {
      0%,
      100% {
        transform: scale(1);
        opacity: 0.5;
      }
      50% {
        transform: scale(1.05);
        opacity: 0.7;
      }
    }
    .animate-float {
      animation: float 8s ease-in-out infinite;
    }
    .animate-pulse-glow {
      animation: pulse-glow 6s ease-in-out infinite;
    }
    .animate-gradient {
      background-size: 200% 200%;
      animation: gradient-shift 8s ease infinite;
    }
    .animate-fade-in-up {
      animation: fade-in-up 0.8s ease-out forwards;
    }
    .animate-scale-in {
      animation: scale-in 0.6s ease-out forwards;
    }
    .animate-pulse-ring {
      animation: pulse-ring 2s ease-out infinite;
    }
    .animate-breathe {
      animation: breathe 4s ease-in-out infinite;
    }

    .delay-100 {
      animation-delay: 0.1s;
    }
    .delay-200 {
      animation-delay: 0.2s;
    }
    .delay-300 {
      animation-delay: 0.3s;
    }
    .delay-400 {
      animation-delay: 0.4s;
    }
    .delay-500 {
      animation-delay: 0.5s;
    }

    .text-gradient {
      background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 50%, #14b8a6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-badge {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    :global(.dark) .hero-badge {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.6) 100%);
    }

    .hero-button-primary {
      background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 50%, #14b8a6 100%);
      background-size: 200% 200%;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-button-primary:hover {
      background-position: 100% 50%;
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(59, 130, 246, 0.4);
    }

    .hero-button-secondary {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.dark) .hero-button-secondary {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.5) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(6, 182, 212, 0.2);
      box-shadow:
        0 4px 24px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .hero-button-secondary:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.15);
    }
    :global(.dark) .hero-button-secondary:hover {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.85) 0%, rgba(15, 23, 42, 0.7) 100%);
      border-color: rgba(6, 182, 212, 0.4);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.4),
        0 0 40px rgba(6, 182, 212, 0.15),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .glow-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      animation: breathe 6s ease-in-out infinite;
    }

    .feature-tab.bg-gray-900:hover {
      color: white;
    }
    :global(.dark) .feature-tab.dark\:bg-white:hover {
      color: rgb(17 24 39);
    }
  </style>

  <section class="relative pt-24 pb-20 md:pt-36 md:pb-32 lg:pt-44 lg:pb-40 overflow-visible">
    <div class="absolute inset-0 pointer-events-none overflow-visible">
      <div
        class="glow-orb w-[700px] h-[700px] -top-40 left-1/4 bg-gradient-to-br from-blue-200/50 via-cyan-100/30 to-transparent dark:from-blue-600/20 dark:via-cyan-500/10"
      >
      </div>
      <div
        class="glow-orb w-[600px] h-[600px] top-1/3 -right-20 bg-gradient-to-bl from-cyan-200/40 via-teal-100/20 to-transparent dark:from-cyan-600/15 dark:via-teal-500/8"
        style="animation-delay: 2s;"
      >
      </div>
      <div
        class="glow-orb w-[500px] h-[500px] -bottom-20 left-1/3 bg-gradient-to-tr from-teal-200/30 via-emerald-100/15 to-transparent dark:from-teal-600/10 dark:via-emerald-500/5"
        style="animation-delay: 4s;"
      >
      </div>

      <div class="absolute top-20 left-10 w-2 h-2 rounded-full bg-blue-400/60 dark:bg-blue-500/40 animate-pulse"></div>
      <div
        class="absolute top-40 right-20 w-1.5 h-1.5 rounded-full bg-cyan-400/60 dark:bg-cyan-500/40 animate-pulse"
        style="animation-delay: 1s;"
      >
      </div>
      <div
        class="absolute bottom-32 left-1/4 w-1 h-1 rounded-full bg-teal-400/60 dark:bg-teal-500/40 animate-pulse"
        style="animation-delay: 2s;"
      >
      </div>
      <div
        class="absolute top-1/2 right-1/3 w-1.5 h-1.5 rounded-full bg-blue-400/40 dark:bg-blue-500/30 animate-pulse"
        style="animation-delay: 0.5s;"
      >
      </div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="animate-fade-in-up opacity-0" style="animation-delay: 0.1s;">
        <div
          class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full hero-badge border border-blue-100/80 dark:border-cyan-800/50 mb-10 md:mb-14 shadow-lg shadow-blue-500/5 dark:shadow-cyan-500/5"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gradient-to-r from-blue-400 to-cyan-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gradient-to-r from-blue-500 to-cyan-500"
            ></span>
          </span>
          <span class="text-sm font-semibold tracking-[0.15em] text-gradient uppercase"
            >Eversec AI Governance Insight</span
          >
        </div>
      </div>

      <h1
        class="animate-fade-in-up opacity-0 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight dark:text-white mb-6 md:mb-8 leading-[1.1]"
        style="animation-delay: 0.2s;"
      >
        <span class="relative inline-block overflow-visible">
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[200%] bg-blue-500 blur-3xl opacity-30 animate-glow-1 pointer-events-none"></span>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[100%] h-[180%] bg-cyan-400 blur-3xl opacity-25 animate-glow-2 pointer-events-none"></span>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[130%] h-[220%] bg-purple-500 blur-3xl opacity-20 animate-glow-3 pointer-events-none"></span>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] h-[160%] bg-indigo-500 blur-3xl opacity-25 animate-glow-4 pointer-events-none"></span>
          <span class="relative text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-400 to-purple-500 bg-[length:200%_auto] animate-gradient">AI 世界的「全息沙盘」</span>
        </span>
      </h1>

      <p
        class="animate-fade-in-up opacity-0 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight dark:text-white mb-8 md:mb-12 leading-tight"
        style="animation-delay: 0.3s;"
      >
        让 AI 的每一次"思考"与"行动"<br class="hidden sm:block" />
        <span class="text-slate-500 dark:text-slate-400 font-normal">全程透明、可溯、可控</span>
      </p>

      <p
        class="animate-fade-in-up opacity-0 text-lg md:text-xl lg:text-2xl text-slate-500 dark:text-slate-400 max-w-4xl mx-auto leading-relaxed mb-12 md:mb-16"
        style="animation-delay: 0.4s;"
      >
        <span class="font-semibold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-400 to-purple-500 bg-[length:200%_auto] animate-gradient">AIGov-Insight</span> 是恒安嘉新打造的全球领先 AI 自主智能体全链路可观测平台<br
          class="hidden md:block"
        />
        专为 <span class="font-medium text-slate-700 dark:text-slate-300">LLM / Agent / MCP / RAG / OpenClaw</span> 打造
      </p>

      <div
        class="animate-fade-in-up opacity-0 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5"
        style="animation-delay: 0.5s;"
      >
        <a
          href={`${base}#quickstart`}
          class="hero-button-primary inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-white font-semibold text-lg shadow-xl shadow-blue-500/25"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
            <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"
            ></path>
            <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
            <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
          </svg>
          快速开始
        </a>
        <a
          href="https://github.com/Eversec-ai/AIGov-Insight-Web"
          target="_blank"
          class="hero-button-secondary inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-slate-700 dark:text-slate-200 font-semibold text-lg border border-slate-200/80 dark:border-slate-700/50"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <section id="advantages" class="py-24 bg-black dark:bg-black relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-blue-900/20 via-transparent to-transparent"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-blue-500/10 rounded-full blur-3xl">
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="text-center mb-20">
        <p class="text-sm font-medium text-blue-400 tracking-widest uppercase mb-4">Core Advantages</p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">四大核心能力</h2>
        <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto font-light">重新定义 AI 安全可观测性标准</p>
      </div>

      <div class="space-y-32">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="order-2 lg:order-1">
            <div class="mb-6">
              <span
                class="inline-block px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-medium"
              >
                Depth Monitoring
              </span>
            </div>
            <h3 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 tracking-tight">看得深</h3>
            <p class="text-lg md:text-xl text-gray-400 leading-relaxed mb-8">
              基于 eBPF 内核级探针技术，深度捕获系统命令执行、敏感文件访问、工具调用等底层行为。完整还原 Shell
              命令行参数、可执行文件路径、文件读写内容。
            </p>
            <div class="flex flex-wrap gap-4">
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>EXEC 命令捕获</span>
              </div>
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>FILE 访问监控</span>
              </div>
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>MCP 工具追踪</span>
              </div>
            </div>
          </div>
          <div class="order-1 lg:order-2">
            <div class="relative">
              <div
                class="absolute -inset-4 bg-gradient-to-r from-blue-600/30 to-cyan-600/30 rounded-3xl blur-2xl opacity-50"
              >
              </div>
              <div class="relative rounded-2xl overflow-hidden shadow-2xl bg-gray-900 border border-gray-800">
                <img
                  src={`${base}screenshots/advantage-deep.png`}
                  alt="EXEC 命令捕获详情"
                  class="w-full aspect-[4/3] object-cover"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="order-2">
            <div class="mb-6">
              <span
                class="inline-block px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-sm font-medium"
              >
                Full Visibility
              </span>
            </div>
            <h3 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 tracking-tight">看得全</h3>
            <p class="text-lg md:text-xl text-gray-400 leading-relaxed mb-8">
              独创全链路智能会话关联算法，自动聚合多源异构日志。精准建立"用户提问 → AI 推理 → 工具调用 →
              系统执行"的完整因果链。
            </p>
            <div class="flex flex-wrap gap-4">
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>多源日志聚合</span>
              </div>
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>因果链还原</span>
              </div>
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>黑盒消除</span>
              </div>
            </div>
          </div>
          <div class="order-1">
            <div class="relative">
              <div
                class="absolute -inset-4 bg-gradient-to-r from-cyan-600/30 to-blue-600/30 rounded-3xl blur-2xl opacity-50"
              >
              </div>
              <div class="relative rounded-2xl overflow-hidden shadow-2xl bg-gray-900 border border-gray-800">
                <img
                  src={`${base}screenshots/advantage-full.png`}
                  alt="会话关联全景视图"
                  class="w-full aspect-[4/3] object-cover"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="order-2 lg:order-1">
            <div class="mb-6">
              <span
                class="inline-block px-4 py-1.5 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-sm font-medium"
              >
                Real-time Response
              </span>
            </div>
            <h3 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 tracking-tight">看得快</h3>
            <p class="text-lg md:text-xl text-gray-400 leading-relaxed mb-8">
              高风险事件毫秒级识别，异常行为 5 秒内定位。可视化时间轴直观呈现攻击突变过程，将传统 30+
              分钟的日志排查缩短至 1 分钟内完成。
            </p>
            <div class="flex flex-wrap gap-4">
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>毫秒级识别</span>
              </div>
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>&lt;1% 性能损耗</span>
              </div>
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
                >
                <span>可视化时间轴</span>
              </div>
            </div>
          </div>
          <div class="order-1 lg:order-2">
            <div class="relative">
              <div
                class="absolute -inset-4 bg-gradient-to-r from-purple-600/30 to-pink-600/30 rounded-3xl blur-2xl opacity-50"
              >
              </div>
              <div class="relative rounded-2xl overflow-hidden shadow-2xl bg-gray-900 border border-gray-800">
                <img
                  src={`${base}screenshots/advantage-fast.png`}
                  alt="时间轴风险高亮界面"
                  class="w-full aspect-[4/3] object-cover"
                />
              </div>
            </div>
