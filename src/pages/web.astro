    <script is:inline>
      let currentFeature = 0;
      const totalFeatures = 5;

      function switchFeature(index) {
        currentFeature = index;

        document.querySelectorAll('.feature-tab').forEach((tab, i) => {
          if (i === index) {
            tab.classList.add('bg-gray-900', 'dark:bg-white', 'text-white', 'dark:text-gray-900');
            tab.classList.remove('text-gray-500', 'dark:text-gray-400');
          } else {
            tab.classList.remove('bg-gray-900', 'dark:bg-white', 'text-white', 'dark:text-gray-900');
            tab.classList.add('text-gray-500', 'dark:text-gray-400');
          }
        });

        document.querySelectorAll('.feature-panel').forEach((panel, i) => {
          if (i === index) {
            panel.classList.remove('hidden');
            panel.style.opacity = '0';
            panel.style.transform = 'translateX(20px)';
            requestAnimationFrame(() => {
              panel.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
              panel.style.opacity = '1';
              panel.style.transform = 'translateX(0)';
            });
          } else {
            panel.classList.add('hidden');
          }
        });
      }

      function prevFeature() {
        const newIndex = currentFeature === 0 ? totalFeatures - 1 : currentFeature - 1;
        switchFeature(newIndex);
      }

      function nextFeature() {
        const newIndex = currentFeature === totalFeatures - 1 ? 0 : currentFeature + 1;
        switchFeature(newIndex);
      }
    </script>
