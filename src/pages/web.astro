        <script is:inline>
          let currentScreenshot = 0;
          const totalScreenshots = 3;

          function updateScreenshotSlider() {
            const slider = document.getElementById('screenshot-slider');
            if (slider) {
              slider.style.transform = `translateX(-${currentScreenshot * 100}%)`;
            }

            for (let i = 0; i < totalScreenshots; i++) {
              const dot = document.getElementById(`screenshot-dot-${i}`);
              if (dot) {
                if (i === currentScreenshot) {
                  dot.classList.remove('bg-gray-300', 'dark:bg-slate-600');
                  dot.classList.add('bg-violet-500', 'dark:bg-violet-400');
                  dot.style.width = '1.5rem';
                } else {
                  dot.classList.remove('bg-violet-500', 'dark:bg-violet-400');
                  dot.classList.add('bg-gray-300', 'dark:bg-slate-600');
                  dot.style.width = '0.625rem';
                }
              }
            }
          }

          function prevScreenshot() {
            currentScreenshot = currentScreenshot === 0 ? totalScreenshots - 1 : currentScreenshot - 1;
            updateScreenshotSlider();
          }

          function nextScreenshot() {
            currentScreenshot = currentScreenshot === totalScreenshots - 1 ? 0 : currentScreenshot + 1;
            updateScreenshotSlider();
          }

          function goToScreenshot(index) {
            currentScreenshot = index;
            updateScreenshotSlider();
          }
        </script>
