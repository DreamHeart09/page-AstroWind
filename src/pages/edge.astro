  <!-- ════════════════════════════════════════════════════════════
       交互脚本 — Carousel + IntersectionObserver（Task 6）
       ════════════════════════════════════════════════════════════ -->
  <script is:inline>
    (function () {
      'use strict';

      function initCarousels() {
        document.querySelectorAll('[data-carousel]').forEach(function (carousel) {
          if (carousel.dataset.carouselReady) return;
          carousel.dataset.carouselReady = '1';

          const slides = carousel.querySelectorAll('[data-carousel-slide]');
          const dots = carousel.querySelectorAll('[data-carousel-dot]');
          const prevBtn = carousel.querySelector('[data-carousel-prev]');
          const nextBtn = carousel.querySelector('[data-carousel-next]');
          let current = 0;
          const total = slides.length;
          if (total === 0) return;

          const track = carousel.querySelector('[data-carousel-track]');

          function measureHeight() {
            if (!track) return;
            // Temporarily make all slides measurable
            let maxH = 0;
            slides.forEach(function (s) {
              const prev = s.style.position;
              s.style.position = 'relative';
              void s.offsetHeight; // force reflow
              if (s.scrollHeight > maxH) maxH = s.scrollHeight;
              s.style.position = prev;
            });
            if (maxH > 0) track.style.minHeight = maxH + 'px';
          }

          // Measure after images load + on resize
          measureHeight();
          carousel.querySelectorAll('img').forEach(function (img) {
            if (!img.complete) img.addEventListener('load', measureHeight, { once: true });
          });
          window.addEventListener('resize', measureHeight);

          function go(index) {
            current = (index + total) % total;
            slides.forEach(function (s, i) {
              s.classList.toggle('is-active', i === current);
            });
            dots.forEach(function (d, i) {
              d.classList.toggle('is-active', i === current);
            });
          }

          if (prevBtn)
            prevBtn.addEventListener('click', function () {
              go(current - 1);
            });
          if (nextBtn)
            nextBtn.addEventListener('click', function () {
              go(current + 1);
            });
          dots.forEach(function (d, i) {
            d.addEventListener('click', function () {
              go(i);
            });
          });

          // 键盘 ←/→
          carousel.setAttribute('tabindex', '0');
          carousel.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowLeft') go(current - 1);
            if (e.key === 'ArrowRight') go(current + 1);
          });

          // 触摸滑动
          let touchStartX = 0;
          carousel.addEventListener(
            'touchstart',
            function (e) {
              touchStartX = e.touches[0].clientX;
            },
            { passive: true }
          );
          carousel.addEventListener(
            'touchend',
            function (e) {
              const diff = e.changedTouches[0].clientX - touchStartX;
              if (Math.abs(diff) > 50) go(diff > 0 ? current - 1 : current + 1);
            },
            { passive: true }
          );
        });
      }

      function initReveal() {
        const reveals = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          reveals.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        reveals.forEach(function (el) {
          observer.observe(el);
        });
      }

      function initLightbox() {
        const lb = document.getElementById('edge-lightbox');
        const lbImg = document.getElementById('edge-lightbox-img');
        const lbEyebrow = document.getElementById('edge-lightbox-eyebrow');
        const lbTitle = document.getElementById('edge-lightbox-title');
        const lbDesc = document.getElementById('edge-lightbox-desc');
        if (!lb || !lbImg || lb.dataset.ready) return;
        lb.dataset.ready = '1';

        const closeBtn = lb.querySelector('.edge-lightbox-close');
        let closeTimer = 0;

        // Extract text from carousel slides
        document.querySelectorAll('.carousel-slide').forEach(function (slide) {
          const img = slide.querySelector('.carousel-screenshot');
          if (!img) return;
          const eyebrow = slide.querySelector('.carousel-eyebrow');
          const title = slide.querySelector('.carousel-title');
          const desc = slide.querySelector('.carousel-subtitle');
          if (eyebrow) img.dataset.lbEyebrow = eyebrow.textContent.trim();
          if (title) img.dataset.lbTitle = title.textContent.trim();
          if (desc) img.dataset.lbDesc = desc.textContent.trim();
        });

        // Extract text from bento cards
        document.querySelectorAll('.bento-screenshot').forEach(function (card) {
          const img = card.querySelector('img');
          if (!img) return;
          const title = card.querySelector('.bento-card-title');
          const desc = card.querySelector('.bento-card-desc');
          if (title) img.dataset.lbTitle = title.textContent.trim();
          if (desc) img.dataset.lbDesc = desc.textContent.trim();
        });

        function open(src, alt, eyebrow, title, desc) {
          clearTimeout(closeTimer);
          lbImg.alt = alt || '';
          lbEyebrow.textContent = eyebrow || '';
          lbEyebrow.style.display = eyebrow ? '' : 'none';
          lbTitle.textContent = title || '';
          lbDesc.textContent = desc || '';

          // Hide image until preloaded to avoid broken-image icon
          lbImg.style.opacity = '0';
          lbImg.removeAttribute('src');

          requestAnimationFrame(function () {
            lb.classList.add('is-open');
          });
          document.body.style.overflow = 'hidden';

          // Preload image; only set src on lightbox img after it's cached
          const preloader = new Image();
          preloader.onload = function () {
            lbImg.src = src;
            lbImg.style.opacity = '';
          };
          preloader.onerror = function () {
            lbImg.src = src;
            lbImg.style.opacity = '';
          };
          preloader.src = src;
        }

        function close() {
          lb.classList.remove('is-open');
          document.body.style.overflow = '';
          closeTimer = setTimeout(function () {
            lbImg.removeAttribute('src');
          }, 500);
        }

        lb.querySelector('.edge-lightbox-backdrop').addEventListener('click', close);
        if (closeBtn) closeBtn.addEventListener('click', close);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && lb.classList.contains('is-open')) close();
        });

        // Bind click on all screenshot images
        document
          .querySelectorAll('.carousel-screenshot, .bento-screenshot img, .highlight-card img')
          .forEach(function (img) {
            if (img.dataset.lbBound) return;
            img.dataset.lbBound = '1';
            img.style.cursor = 'zoom-in';
            img.addEventListener('click', function (e) {
              e.stopPropagation();
              const card = img.closest('.highlight-card');
              const title = img.dataset.lbTitle || (card && card.dataset.lbTitle) || img.alt || '';
              const desc = img.dataset.lbDesc || (card && card.dataset.lbDesc) || '';
              const eyebrow = img.dataset.lbEyebrow || '';
              open(img.src, img.alt, eyebrow, title, desc);
            });
          });
      }

      function boot() {
        initCarousels();
        initReveal();
        initLightbox();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }

      // Astro client-side navigation (View Transitions / swup)
      document.addEventListener('astro:page-load', boot);
      document.addEventListener('astro:after-swap', boot);
    })();
  </script>
