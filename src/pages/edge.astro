---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'AIGov Insight Edge — AI-Native macOS 可观测平台',
  description: 'AI 原生、本地优先的 AI Agent 工作流可观测与治理平台。',
};

const base = import.meta.env.BASE_URL;
---

<Layout metadata={metadata}>
  <style>
    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(32px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes scale-in {
      from { opacity: 0; transform: scale(0.96); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes float-slow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-12px); }
    }
    @keyframes gradient-shift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }
    @keyframes glow-pulse {
      0%, 100% { opacity: 0.3; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.05); }
    }
    .anim-fade-in-up { animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .anim-fade-in { animation: fade-in 1s ease forwards; }
    .anim-scale-in { animation: scale-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .anim-float { animation: float-slow 6s ease-in-out infinite; }

    .glass-card {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.5);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.dark) .glass-card {
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .glass-card:hover {
      transform: translateY(-3px) scale(1.006);
      box-shadow: 0 20px 60px -12px rgba(0,0,0,0.12), 0 0 48px -16px rgba(108,140,255,0.15);
    }
    :global(.dark) .glass-card:hover {
      box-shadow: 0 20px 60px -12px rgba(0,0,0,0.4), 0 0 48px -16px rgba(108,140,255,0.2);
    }

    .feature-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 16px;
      border-radius: 100px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .edge-gradient-text {
      background: linear-gradient(135deg, #6c8cff 0%, #a78bfa 40%, #c084fc 70%, #818cf8 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradient-shift 6s ease infinite;
    }

    .hero-glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      pointer-events: none;
      animation: glow-pulse 8s ease-in-out infinite;
    }

    .screenshot-frame {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      background: linear-gradient(180deg, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0) 100%);
    }
    :global(.dark) .screenshot-frame {
      background: linear-gradient(180deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0) 100%);
    }
    .screenshot-frame::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 16px;
      border: 1px solid rgba(0,0,0,0.08);
      pointer-events: none;
      z-index: 2;
    }

    .mac-window {
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 0 0 1px rgba(0,0,0,0.08), 0 20px 60px -12px rgba(0,0,0,0.2), 0 0 120px -40px rgba(108,140,255,0.15);
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.dark) .mac-window {
      box-shadow: 0 0 0 1px rgba(255,255,255,0.06), 0 20px 60px -12px rgba(0,0,0,0.5), 0 0 120px -40px rgba(108,140,255,0.2);
    }
    .mac-window:hover {
      transform: scale(1.01);
      box-shadow: 0 0 0 1px rgba(0,0,0,0.08), 0 30px 80px -12px rgba(0,0,0,0.25), 0 0 160px -40px rgba(108,140,255,0.2);
    }
    .mac-titlebar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      background: rgba(245, 245, 247, 0.95);
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }
    :global(.dark) .mac-titlebar {
      background: rgba(30, 30, 42, 0.95);
      border-bottom-color: rgba(255,255,255,0.06);
    }
    .mac-dot { width: 12px; height: 12px; border-radius: 50%; }

    .stat-value { font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }

    .reveal {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .plugin-badge { position: relative; overflow: hidden; }
    .plugin-badge::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent 0%, transparent 40%, rgba(255,255,255,0.3) 50%, transparent 60%, transparent 100%);
      animation: shimmer 3s infinite;
    }

    .copilot-flow { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .copilot-flow-step { text-align: center; padding: 16px 20px; border-radius: 12px; background: rgba(108,140,255,0.08); border: 1px solid rgba(108,140,255,0.15); min-width: 120px; }
    .step-num { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, #6c8cff, #a78bfa); color: white; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; }
    .step-label { font-size: 13px; font-weight: 600; color: #1e293b; }
    :global(.dark) .step-label { color: #e2e8f0; }
    .step-sub { font-size: 11px; color: #94a3b8; margin-top: 4px; }
    .flow-arrow { color: #6c8cff; font-size: 20px; font-weight: 300; }

    .tool-card-mockup { border-radius: 10px; padding: 14px 18px; margin-bottom: 8px; position: relative; overflow: hidden; }
    .tool-card-mockup.executing { background: rgba(108,140,255,0.06); border: 1px solid rgba(108,140,255,0.2); }
    .tool-card-mockup.success { background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); }
    .tool-card-mockup-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .tool-card-mockup-name { font-size: 13px; font-weight: 600; font-family: monospace; color: #1e293b; }
    :global(.dark) .tool-card-mockup-name { color: #e2e8f0; }
    .tool-name-zh { font-size: 11px; color: #94a3b8; margin-left: 6px; font-weight: 400; font-family: system-ui; }
    .tool-card-mockup-status { font-size: 11px; font-weight: 600; }
    .tool-card-mockup-status.executing { color: #6c8cff; }
    .tool-card-mockup-status.success { color: #10b981; }
    .tool-card-mockup-params { font-size: 11px; color: #64748b; margin: 0; font-family: monospace; }
    .tool-card-mockup-result { font-size: 11px; color: #10b981; margin-top: 6px; font-family: monospace; }
    .tool-card-mockup-caption { font-size: 11px; color: #94a3b8; text-align: center; }

    .copilot-dialogue { font-family: monospace; font-size: 12px; line-height: 1.8; white-space: pre-wrap; color: #475569; margin: 0; }
    :global(.dark) .copilot-dialogue { color: #94a3b8; }
    .dlg-user { color: #64748b; font-weight: 600; }
    .dlg-ai { color: #6c8cff; font-weight: 600; }
    .dlg-tool { color: #a78bfa; }
    .dlg-reply { color: #10b981; }
    .dialogue-label { font-size: 12px; font-weight: 600; color: #94a3b8; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.06em; }

    .ai-native-card { padding: 28px; }
    .ai-native-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .ai-native-title { font-size: 16px; font-weight: 700; color: #1e293b; margin-bottom: 8px; }
    :global(.dark) .ai-native-title { color: #e2e8f0; }
    .since-tag { font-size: 10px; color: #94a3b8; margin-left: 8px; font-weight: 400; }
    .ai-native-desc { font-size: 13px; color: #64748b; line-height: 1.6; }
    :global(.dark) .ai-native-desc { color: #94a3b8; }

    .gui-stat-card { text-align: center; padding: 20px 16px; border-radius: 16px; background: rgba(255,255,255,0.6); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.5); }
    :global(.dark) .gui-stat-card { background: rgba(15,23,42,0.5); border-color: rgba(255,255,255,0.06); }

    .benchmark-card { padding: 24px; border-radius: 16px; background: rgba(15,23,42,0.03); border: 1px solid rgba(0,0,0,0.06); text-align: center; }
    :global(.dark) .benchmark-card { background: rgba(108,140,255,0.04); border-color: rgba(108,140,255,0.12); }

    .roadmap-card { padding: 24px; border-radius: 16px; }
    .roadmap-card h4 { font-size: 15px; font-weight: 700; color: #1e293b; margin-bottom: 6px; }
    :global(.dark) .roadmap-card h4 { color: #e2e8f0; }
    .roadmap-card p { font-size: 13px; color: #64748b; margin: 0; }
    :global(.dark) .roadmap-card p { color: #94a3b8; }
    .roadmap-pill { display: inline-block; padding: 4px 12px; border-radius: 100px; font-size: 11px; font-weight: 600; background: rgba(16,185,129,0.1); color: #10b981; margin-right: 6px; margin-bottom: 6px; }
    :global(.dark) .roadmap-pill { background: rgba(16,185,129,0.15); }

    @keyframes pulse-border {
      0%, 100% { border-color: rgba(108,140,255,0.3); }
      50% { border-color: rgba(108,140,255,0.6); }
    }

    @media (prefers-reduced-motion: reduce) {
      .anim-fade-in-up, .anim-fade-in, .anim-scale-in, .anim-float,
      .reveal, .plugin-badge::after, .hero-glow, .edge-gradient-text {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
  <!-- ═══════════════════════════════════════════════════════
       § 4  AI COPILOT DEEP DIVE
       ═══════════════════════════════════════════════════════ -->
  <section class="py-24 md:py-32 bg-slate-50 dark:bg-[#0a0a0f]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16 reveal">
        <div class="feature-pill bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 mb-6">AI Copilot · NEW</div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white tracking-tight mb-6">
          🤖 AI Copilot · <span class="edge-gradient-text">真正操作 GUI 的智能体</span>
        </h2>
        <p class="text-xl text-slate-500 dark:text-slate-400 max-w-3xl mx-auto font-light">
          ReAct Loop · 15 GUI 工具 · 屏幕感知 · 生产级 UX 控件
        </p>
      </div>

      <!-- ReAct Loop Flow Diagram -->
      <div class="reveal glass-card rounded-2xl p-8 md:p-10 mb-8">
        <div class="text-xs font-semibold tracking-[0.1em] uppercase text-slate-400 dark:text-slate-500 mb-6">ReAct Loop · 最多 5 轮 · AbortController 可中断</div>
        <div class="copilot-flow">
          <div class="copilot-flow-step">
            <div class="step-num">1</div>
            <div class="step-label">User Prompt</div>
            <div class="step-sub">用户输入</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="copilot-flow-step">
            <div class="step-num">2</div>
            <div class="step-label">Electron Main · LLM</div>
            <div class="step-sub">node-llama-cpp</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="copilot-flow-step">
            <div class="step-num">3</div>
            <div class="step-label">&lt;tool_call&gt;</div>
            <div class="step-sub">parse 4 formats</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="copilot-flow-step">
            <div class="step-num">4</div>
            <div class="step-label">IPC → Renderer</div>
            <div class="step-sub">execute GUI tool</div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="copilot-flow-step">
            <div class="step-num">5</div>
            <div class="step-label">Natural Reply</div>
            <div class="step-sub">round &lt; 5</div>
          </div>
        </div>
      </div>

      <!-- Tool Call Card Mockups -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="reveal glass-card rounded-2xl p-6">
          <div class="tool-card-mockup executing">
            <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#6c8cff,transparent);animation:shimmer 2s infinite;"></div>
            <div class="tool-card-mockup-header">
              <span class="tool-card-mockup-name">navigate<span class="tool-name-zh">导航</span></span>
              <span class="tool-card-mockup-status executing">● executing</span>
            </div>
            <pre class="tool-card-mockup-params">&#123;"screen": "timeline"&#125;</pre>
          </div>
          <p class="tool-card-mockup-caption mt-2">执行中 · pulse 动画 · ToolCallCard.executing</p>
        </div>
        <div class="reveal glass-card rounded-2xl p-6">
          <div class="tool-card-mockup success">
            <div class="tool-card-mockup-header">
              <span class="tool-card-mockup-name">navigate<span class="tool-name-zh">导航</span></span>
              <span class="tool-card-mockup-status success">✓ success</span>
            </div>
            <pre class="tool-card-mockup-params">&#123;"screen": "timeline"&#125;</pre>
            <div class="tool-card-mockup-result">→ Navigated to Timeline · 142 LLM calls ready</div>
          </div>
          <p class="tool-card-mockup-caption mt-2">执行成功 · 携带结果 · ToolCallCard.success</p>
        </div>
      </div>

      <!-- Example Dialogue -->
      <div class="reveal glass-card rounded-2xl p-6 md:p-8 mb-8">
        <div class="dialogue-label">Example Dialogue · 实际对话示例</div>
        <pre class="copilot-dialogue"><span class="dlg-user">你 ›</span> 打开时间线, 筛选最近 7 天, 缩放到 1 小时

<span class="dlg-ai">AI ›</span> 正在分析需求, 调用 3 个工具...
<span class="dlg-tool">   &lt;tool_call&gt;&#123;"name":"navigate","args":&#123;"screen":"timeline"&#125;&#125;&lt;/tool_call&gt;</span>
<span class="dlg-tool">   &lt;tool_call&gt;&#123;"name":"set_time_range","args":&#123;"preset":"7d"&#125;&#125;&lt;/tool_call&gt;</span>
<span class="dlg-tool">   &lt;tool_call&gt;&#123;"name":"set_timeline_zoom","args":&#123;"level":9&#125;&#125;&lt;/tool_call&gt;</span>
<span class="dlg-reply">已为你打开 Timeline 页面, 时间范围筛选为最近 7 天, 缩放级别 1h。
当前显示 142 次 LLM 调用、56 次工具调用, 总成本 ¥0.84。
需要进一步下钻或分析某条调用吗?</span></pre>
      </div>

      <!-- UX Controls -->
      <div class="reveal glass-card rounded-2xl p-6 md:p-8">
        <div class="text-sm font-bold text-slate-900 dark:text-white mb-3">Production-grade UX Controls · 生产级控件</div>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
          <span class="font-semibold text-slate-700 dark:text-slate-200">Context 保持</span> · <span class="font-semibold text-slate-700 dark:text-slate-200">MaxTokens 6 档</span> · <span class="font-semibold text-slate-700 dark:text-slate-200">Tools 开关</span> · <span class="font-semibold text-slate-700 dark:text-slate-200">Stop 中断</span> · <span class="font-semibold text-slate-700 dark:text-slate-200">Detail Context 注入</span> · <span class="font-semibold text-slate-700 dark:text-slate-200">Streaming tok/s</span> · <span class="font-semibold text-slate-700 dark:text-slate-200">Regenerate 重新生成</span> — 全部 7 步 Onboarding 即可上手。
        </p>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════
       § 4b  AI-NATIVE CAPABILITIES
       ═══════════════════════════════════════════════════════ -->
  <section class="py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16 reveal">
        <div class="feature-pill bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 mb-6">AI-Native · NEW</div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white tracking-tight mb-6">
          🧠 AI-Native · <span class="edge-gradient-text">永远在线的智能洞察</span>
        </h2>
        <p class="text-xl text-slate-500 dark:text-slate-400 max-w-3xl mx-auto font-light">
          4 个 AI 原生组件, 让数据自己说话
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        <div class="reveal glass-card ai-native-card rounded-2xl">
          <div class="ai-native-icon" style="background: rgba(239,68,68,0.1); color: #ef4444;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div class="ai-native-title">AiAnomalyDetector <span class="since-tag">since v1.x</span></div>
          <div class="ai-native-desc">异常检测 — 自动发现费用异常、错误聚集、Agent 异常行为，三档严重度 (HIGH / MED / LOW)，AI 给出诊断建议。</div>
        </div>

        <div class="reveal glass-card ai-native-card rounded-2xl">
          <div class="ai-native-icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div class="ai-native-title">AiCostSimulator <span class="since-tag">since v1.x</span></div>
          <div class="ai-native-desc">成本模拟 — 一键模拟切换到 GPT-4o / Claude Sonnet / DeepSeek / Qwen，立即看到输入输出成本变化，AI 给出优化建议。</div>
        </div>

        <div class="reveal glass-card ai-native-card rounded-2xl">
          <div class="ai-native-icon" style="background: rgba(59,130,246,0.1); color: #3b82f6;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </div>
          <div class="ai-native-title">AiDailyBrief <span class="since-tag">since v1.x</span></div>
          <div class="ai-native-desc">每日简报 — 每日早晨一眼掌握昨日关键数据：总会话、Token 消耗、费用、Top 模型、Top 工具、异常事件，AI 自动生成 Markdown 摘要。</div>
        </div>

        <div class="reveal glass-card ai-native-card rounded-2xl">
          <div class="ai-native-icon" style="background: rgba(108,140,255,0.1); color: #6c8cff;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L9 9l-7 1 5 5-1 7 6-3 6 3-1-7 5-5-7-1z"/></svg>
          </div>
          <div class="ai-native-title">AiSpotlight <span class="since-tag">since v1.x</span></div>
          <div class="ai-native-desc">AI Spotlight — 全局 ⌘K 唤起，NL-to-Filter 自然语言过滤，自动高亮最相关的 AI 洞察、异常、费用热点。</div>
        </div>
      </div>

      <div class="reveal glass-card rounded-2xl p-6 md:p-8 mt-8">
        <div class="text-sm font-bold text-slate-900 dark:text-white mb-2">从「可观测」到「AI-Native」的跨越</div>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
          传统监控让你<span class="font-semibold text-slate-700 dark:text-slate-200">看见</span>数据，AIGov Insight Edge 的 AI-Native 组件让你<span class="font-semibold text-slate-700 dark:text-slate-200">理解</span>数据。异常检测自动捕获风险、成本模拟给出 What-if、每日简报省下 30 分钟、Spotlight 一键直达最相关的洞察 — 这才是 AI 时代可观测工具应有的样子。
        </p>
      </div>
