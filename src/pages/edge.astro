---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'AIGov Insight Edge — AI-Native macOS 可观测平台',
  description: 'AI 原生、本地优先的 AI Agent 工作流可观测与治理平台。macOS 桌面端，AI Copilot 驱动 GUI 操控。',
};

const base = import.meta.env.BASE_URL;
---

<Layout metadata={metadata}>
  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-30px) rotate(2deg); }
    }
    @keyframes pulse-glow {
      0%, 100% { opacity: 0.4; transform: scale(1); filter: blur(60px); }
      50% { opacity: 0.7; transform: scale(1.1); filter: blur(80px); }
    }
    @keyframes gradient-shift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }
    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scale-in {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes breathe {
      0%, 100% { transform: scale(1); opacity: 0.5; }
      50% { transform: scale(1.05); opacity: 0.7; }
    }
    @keyframes glow-1 {
      0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(1); }
      50% { opacity: 0.5; transform: translate(-50%, -50%) scale(1.2); }
    }
    @keyframes glow-2 {
      0%, 100% { opacity: 0.2; transform: translate(-50%, -50%) scale(1.1); }
      50% { opacity: 0.4; transform: translate(-50%, -50%) scale(0.9); }
    }
    @keyframes glow-3 {
      0%, 100% { opacity: 0.15; transform: translate(-50%, -50%) scale(0.9); }
      50% { opacity: 0.35; transform: translate(-50%, -50%) scale(1.15); }
    }
    @keyframes glow-4 {
      0%, 100% { opacity: 0.25; transform: translate(-50%, -50%) scale(1.05); }
      50% { opacity: 0.45; transform: translate(-50%, -50%) scale(0.95); }
    }
    .animate-float { animation: float 8s ease-in-out infinite; }
    .animate-pulse-glow { animation: pulse-glow 6s ease-in-out infinite; }
    .animate-gradient { background-size: 200% 200%; animation: gradient-shift 8s ease infinite; }
    .animate-fade-in-up { animation: fade-in-up 0.8s ease-out forwards; }
    .animate-scale-in { animation: scale-in 0.6s ease-out forwards; }
    .animate-breathe { animation: breathe 4s ease-in-out infinite; }
    .animate-glow-1 { animation: glow-1 6s ease-in-out infinite; }
    .animate-glow-2 { animation: glow-2 8s ease-in-out infinite; }
    .animate-glow-3 { animation: glow-3 7s ease-in-out infinite; }
    .animate-glow-4 { animation: glow-4 5s ease-in-out infinite; }

    .delay-100 { animation-delay: 0.1s; }
    .delay-200 { animation-delay: 0.2s; }
    .delay-300 { animation-delay: 0.3s; }
    .delay-400 { animation-delay: 0.4s; }
    .delay-500 { animation-delay: 0.5s; }
    .delay-600 { animation-delay: 0.6s; }
    .delay-700 { animation-delay: 0.7s; }

    .text-gradient {
      background: linear-gradient(135deg, #818cf8 0%, #a78bfa 40%, #c084fc 70%, #6c8cff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .text-gradient-subtle {
      background: linear-gradient(135deg, #6c8cff 0%, #a78bfa 50%, #c084fc 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-badge {
      background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(248,250,252,0.8) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    :global(.dark) .hero-badge {
      background: linear-gradient(135deg, rgba(30,41,59,0.8) 0%, rgba(15,23,42,0.6) 100%);
    }

    .hero-button-primary {
      background: linear-gradient(135deg, #6c8cff 0%, #a78bfa 50%, #c084fc 100%);
      background-size: 200% 200%;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-button-primary:hover {
      background-position: 100% 50%;
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(108,140,255,0.4);
    }

    .hero-button-secondary {
      background: rgba(255,255,255,0.8);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.dark) .hero-button-secondary {
      background: linear-gradient(135deg, rgba(30,41,59,0.7) 0%, rgba(15,23,42,0.5) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(108,140,255,0.2);
      box-shadow: 0 4px 24px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.05);
    }
    .hero-button-secondary:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(0,0,0,0.15);
    }
    :global(.dark) .hero-button-secondary:hover {
      background: linear-gradient(135deg, rgba(30,41,59,0.85) 0%, rgba(15,23,42,0.7) 100%);
      border-color: rgba(108,140,255,0.4);
      box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 0 40px rgba(108,140,255,0.15), inset 0 1px 0 rgba(255,255,255,0.08);
    }

    .glow-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      animation: breathe 6s ease-in-out infinite;
    }

    .bento-card {
      position: relative;
      border-radius: 1.5rem;
      overflow: hidden;
      padding: 2rem;
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bento-card:hover { transform: translateY(-4px); }

    .bento-card-sm {
      position: relative;
      border-radius: 1.25rem;
      overflow: hidden;
      padding: 1.5rem;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bento-card-sm:hover { transform: translateY(-2px); }

    .metric-card {
      text-align: center;
      padding: 1.5rem 1rem;
      border-radius: 1rem;
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.5);
    }
    :global(.dark) .metric-card {
      background: rgba(15,23,42,0.5);
      border-color: rgba(255,255,255,0.06);
    }

    .tech-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 100px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .mac-window {
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 0 0 1px rgba(0,0,0,0.08), 0 20px 60px -12px rgba(0,0,0,0.2), 0 0 120px -40px rgba(108,140,255,0.15);
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.dark) .mac-window {
      box-shadow: 0 0 0 1px rgba(255,255,255,0.06), 0 20px 60px -12px rgba(0,0,0,0.5), 0 0 120px -40px rgba(108,140,255,0.2);
    }
    .mac-window:hover {
      transform: scale(1.01);
      box-shadow: 0 0 0 1px rgba(0,0,0,0.08), 0 30px 80px -12px rgba(0,0,0,0.25), 0 0 160px -40px rgba(108,140,255,0.2);
    }
    .mac-titlebar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      background: rgba(245, 245, 247, 0.95);
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }
    :global(.dark) .mac-titlebar {
      background: rgba(30, 30, 42, 0.95);
      border-bottom-color: rgba(255,255,255,0.06);
    }
    .mac-dot { width: 12px; height: 12px; border-radius: 50%; }

    .stat-value { font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }

    .plugin-card {
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255,255,255,0.5);
      border-radius: 1.25rem;
      padding: 2rem;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.dark) .plugin-card {
      background: rgba(15,23,42,0.5);
      border-color: rgba(255,255,255,0.06);
    }
    .plugin-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 60px -12px rgba(0,0,0,0.12);
    }
    :global(.dark) .plugin-card:hover {
      box-shadow: 0 20px 60px -12px rgba(0,0,0,0.4);
    }

    .copilot-dialogue { font-family: monospace; font-size: 12px; line-height: 1.8; white-space: pre-wrap; color: #475569; margin: 0; }
    :global(.dark) .copilot-dialogue { color: #94a3b8; }
    .dlg-user { color: #64748b; font-weight: 600; }
    .dlg-ai { color: #818cf8; font-weight: 600; }
    .dlg-tool { color: #a78bfa; }
    .dlg-reply { color: #10b981; }

    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-float, .animate-pulse-glow, .animate-gradient,
      .animate-fade-in-up, .animate-scale-in, .animate-breathe,
      .animate-glow-1, .animate-glow-2, .animate-glow-3, .animate-glow-4 {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
      .reveal { opacity: 1; transform: none; }
    }
  </style>

  <!-- ═══ HERO ═══ -->
  <section class="relative pt-24 pb-20 md:pt-36 md:pb-32 lg:pt-44 lg:pb-40 overflow-visible">
    <div class="absolute inset-0 pointer-events-none overflow-visible">
      <div class="glow-orb w-[700px] h-[700px] -top-40 left-1/4 bg-gradient-to-br from-indigo-200/50 via-purple-100/30 to-transparent dark:from-indigo-600/20 dark:via-purple-500/10"></div>
      <div class="glow-orb w-[600px] h-[600px] top-1/3 -right-20 bg-gradient-to-bl from-purple-200/40 via-violet-100/20 to-transparent dark:from-purple-600/15 dark:via-violet-500/8" style="animation-delay: 2s;"></div>
      <div class="glow-orb w-[500px] h-[500px] -bottom-20 left-1/3 bg-gradient-to-tr from-violet-200/30 via-indigo-100/15 to-transparent dark:from-violet-600/10 dark:via-indigo-500/5" style="animation-delay: 4s;"></div>
      <div class="absolute top-20 left-10 w-2 h-2 rounded-full bg-indigo-400/60 dark:bg-indigo-500/40 animate-pulse"></div>
      <div class="absolute top-40 right-20 w-1.5 h-1.5 rounded-full bg-purple-400/60 dark:bg-purple-500/40 animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute bottom-32 left-1/4 w-1 h-1 rounded-full bg-violet-400/60 dark:bg-violet-500/40 animate-pulse" style="animation-delay: 2s;"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="animate-fade-in-up opacity-0" style="animation-delay: 0.1s;">
        <div class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full hero-badge border border-indigo-100/80 dark:border-indigo-800/50 mb-10 md:mb-14 shadow-lg shadow-indigo-500/5 dark:shadow-indigo-500/5">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gradient-to-r from-indigo-400 to-purple-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gradient-to-r from-indigo-500 to-purple-500"></span>
          </span>
          <span class="text-sm font-semibold tracking-[0.15em] text-gradient uppercase">AIGov Insight Edge</span>
        </div>
      </div>

      <h1 class="animate-fade-in-up opacity-0 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight dark:text-white mb-6 md:mb-8 leading-[1.1]" style="animation-delay: 0.2s;">
        <span class="relative inline-block overflow-visible">
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[200%] bg-indigo-500 blur-3xl opacity-30 animate-glow-1 pointer-events-none"></span>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[100%] h-[180%] bg-purple-400 blur-3xl opacity-25 animate-glow-2 pointer-events-none"></span>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[130%] h-[220%] bg-violet-500 blur-3xl opacity-20 animate-glow-3 pointer-events-none"></span>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] h-[160%] bg-blue-500 blur-3xl opacity-25 animate-glow-4 pointer-events-none"></span>
          <span class="relative text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 via-purple-400 to-violet-500 bg-[length:200%_auto] animate-gradient">macOS 端侧 AI 可观测平台</span>
        </span>
      </h1>

      <p class="animate-fade-in-up opacity-0 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight dark:text-white mb-8 md:mb-12 leading-tight" style="animation-delay: 0.3s;">
        AI Copilot 驱动<br class="hidden sm:block" />
        <span class="text-slate-500 dark:text-slate-400 font-normal">100% 本地运行，零云端依赖</span>
      </p>

      <p class="animate-fade-in-up opacity-0 text-lg md:text-xl lg:text-2xl text-slate-500 dark:text-slate-400 max-w-4xl mx-auto leading-relaxed mb-12 md:mb-16" style="animation-delay: 0.4s;">
        <span class="font-semibold text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 via-purple-400 to-violet-500 bg-[length:200%_auto] animate-gradient">AIGov Insight Edge</span> 是恒安嘉新打造的 macOS 端侧 AI 可观测平台<br class="hidden md:block" />
        覆盖 <span class="font-medium text-slate-700 dark:text-slate-300">OpenClaw / Hermes / Claude Code</span> 插件生态
      </p>

      <div class="animate-fade-in-up opacity-0 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto mb-12 md:mb-16" style="animation-delay: 0.5s;">
        <div class="metric-card">
          <div class="text-2xl md:text-3xl font-bold text-gradient mb-1">11</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">GUI 页面</div>
        </div>
        <div class="metric-card">
          <div class="text-2xl md:text-3xl font-bold text-gradient mb-1">17</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">GUI 工具</div>
        </div>
        <div class="metric-card">
          <div class="text-2xl md:text-3xl font-bold text-gradient mb-1">100%</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">本地优先</div>
        </div>
        <div class="metric-card">
          <div class="text-2xl md:text-3xl font-bold text-gradient mb-1">0</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">Cloud calls</div>
        </div>
      </div>

      <div class="animate-fade-in-up opacity-0 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5" style="animation-delay: 0.6s;">
        <a href="#quickstart" class="hero-button-primary inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-white font-semibold text-lg shadow-xl shadow-indigo-500/25">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
          下载 Edge
        </a>
        <a href="https://github.com/Eversec-ai/AIGov-Insight-Edge" target="_blank" class="hero-button-secondary inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-slate-700 dark:text-slate-200 font-semibold text-lg border border-slate-200/80 dark:border-slate-700/50">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </section>


  <!-- ═══ BENTO GRID — 核心能力 ═══ -->
  <section id="capabilities" class="py-24 md:py-32 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16 reveal">
        <p class="text-sm font-medium text-indigo-600 dark:text-indigo-400 tracking-[0.2em] uppercase mb-4">Core Capabilities</p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight">重新定义桌面可观测</h2>
        <p class="text-xl text-gray-500 dark:text-gray-400 max-w-3xl mx-auto font-light">AI 原生架构，从数据采集到智能洞察，每一个环节都精心打磨</p>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- AI Copilot — 大卡片横跨两列 -->
        <div class="reveal lg:col-span-2 bento-card bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:shadow-2xl hover:shadow-indigo-500/10 hover:border-indigo-300 dark:hover:border-indigo-600/40">
          <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-bl from-indigo-500/5 to-transparent rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
              </div>
              <span class="text-xs font-semibold tracking-[0.1em] uppercase text-indigo-600 dark:text-indigo-400">AI Copilot</span>
            </div>
            <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-3 tracking-tight">真正操作 GUI 的智能体</h3>
            <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-6 max-w-lg">ReAct Loop 驱动，15 个 GUI 工具，屏幕感知能力。不只是聊天，而是直接操控桌面界面。</p>

            <!-- ReAct Flow -->
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 border border-indigo-200/50 dark:border-indigo-700/30">
                <span class="w-5 h-5 rounded-full bg-indigo-500 text-white text-[10px] font-bold flex items-center justify-center">1</span>
                <span class="text-xs font-medium text-indigo-700 dark:text-indigo-300">User Prompt</span>
              </div>
              <svg class="w-4 h-4 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-purple-50 dark:bg-purple-900/30 border border-purple-200/50 dark:border-purple-700/30">
                <span class="w-5 h-5 rounded-full bg-purple-500 text-white text-[10px] font-bold flex items-center justify-center">2</span>
