---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'AIGov Insight Edge — AI-Native macOS 可观测平台',
  description: 'AI 原生、本地优先的 AI Agent 工作流可观测与治理平台。macOS 桌面端，AI Copilot 驱动 GUI 操控。',
};

const base = import.meta.env.BASE_URL;
---

<Layout metadata={metadata}>
  <div class="edge-page">
    <style>
      /* ════════════════════════════════════════════════════════════
         设计令牌 — Design Tokens（暗色为主，亮色可用）
         ════════════════════════════════════════════════════════════ */
      .edge-page {
        /* 亮色令牌（默认） */
        --edge-bg-base: #f2f2f7;
        --edge-bg-elevated: #ffffff;
        --edge-bg-surface: #fafafc;
        --edge-bg-field: #f5f5fa;
        --edge-text-primary: #1a1a24;
        --edge-text-secondary: #505068;
        --edge-text-tertiary: #8888a0;
        --edge-primary: #5068e0;
        --edge-primary-subtle: rgba(80, 104, 224, 0.1);
        --edge-primary-glow: rgba(80, 104, 224, 0.14);
        --edge-accent: #8b4fed;
        --edge-accent-subtle: rgba(139, 79, 237, 0.1);
        --edge-success: #2da855;
        --edge-success-subtle: rgba(45, 168, 85, 0.1);
        --edge-warning: #d4910a;
        --edge-error: #dc3545;
        --edge-error-subtle: rgba(220, 53, 69, 0.1);
        --edge-gradient-1: linear-gradient(135deg, #5068e0 0%, #8b4fed 100%);
        --edge-gradient-2: linear-gradient(135deg, #2da855 0%, #1a9bb8 100%);
        --edge-border: rgba(0, 0, 0, 0.06);
        --edge-border-strong: rgba(0, 0, 0, 0.1);
        --edge-glass-bg: rgba(255, 255, 255, 0.42);
        --edge-glass-border: rgba(0, 0, 0, 0.08);
        --edge-glass-bg-refined: rgba(255, 255, 255, 0.35);
        --edge-glass-highlight: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.7) 0%,
          rgba(255, 255, 255, 0.2) 40%,
          transparent 100%
        );
        --edge-glass-shadow-l2: 0 4px 16px rgba(0, 0, 0, 0.04);
        --edge-glass-shadow-l3: 0 12px 48px rgba(0, 0, 0, 0.08);
        --edge-glow-primary: 0 0 80px -24px rgba(80, 104, 224, 0.18);
        --edge-radius-sm: 8px;
        --edge-radius-md: 12px;
        --edge-radius-lg: 16px;
        --edge-radius-xl: 22px;
        --edge-transition-fast: 180ms cubic-bezier(0.22, 0.61, 0.36, 1);
        --edge-transition-base: 280ms cubic-bezier(0.22, 0.61, 0.36, 1);
        --edge-transition-slow: 450ms cubic-bezier(0.22, 0.61, 0.36, 1);
        color: var(--edge-text-primary);
      }

      :global(.dark) .edge-page {
        /* 暗色令牌 */
        --edge-bg-base: #08080c;
        --edge-bg-elevated: #0e0e14;
        --edge-bg-surface: #131318;
        --edge-bg-field: #16161e;
        --edge-text-primary: #e8e9f0;
        --edge-text-secondary: #a0a0b8;
        --edge-text-tertiary: #6e6e88;
        --edge-primary: #7996ff;
        --edge-primary-subtle: rgba(121, 150, 255, 0.1);
        --edge-primary-glow: rgba(121, 150, 255, 0.18);
        --edge-accent: #b98aff;
        --edge-accent-subtle: rgba(185, 138, 255, 0.1);
        --edge-success: #40d675;
        --edge-success-subtle: rgba(64, 214, 117, 0.1);
        --edge-warning: #f5ac37;
        --edge-error: #f5515b;
        --edge-error-subtle: rgba(245, 81, 91, 0.1);
        --edge-gradient-1: linear-gradient(135deg, #7996ff 0%, #b98aff 100%);
        --edge-gradient-2: linear-gradient(135deg, #40d675 0%, #3dc9e8 100%);
        --edge-border: rgba(255, 255, 255, 0.08);
        --edge-border-strong: rgba(255, 255, 255, 0.13);
        --edge-glass-bg: rgba(10, 10, 18, 0.52);
        --edge-glass-border: rgba(255, 255, 255, 0.08);
        --edge-glass-bg-refined: rgba(18, 18, 30, 0.72);
        --edge-glass-highlight: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.08) 0%,
          rgba(255, 255, 255, 0.02) 40%,
          transparent 100%
        );
        --edge-glass-shadow-l2: 0 4px 16px rgba(0, 0, 0, 0.08);
        --edge-glass-shadow-l3: 0 12px 48px rgba(0, 0, 0, 0.16);
        --edge-glow-primary: 0 0 80px -24px rgba(121, 150, 255, 0.28);
      }

      /* ═══ 动画 keyframes（保留 + 新增 carousel 过渡） ═══ */
      @keyframes float {
        0%,
        100% {
          transform: translateY(0px) rotate(0deg);
        }
        50% {
          transform: translateY(-30px) rotate(2deg);
        }
      }
      @keyframes pulse-glow {
        0%,
        100% {
          opacity: 0.4;
          transform: scale(1);
          filter: blur(60px);
        }
        50% {
          opacity: 0.7;
          transform: scale(1.1);
          filter: blur(80px);
        }
      }
      @keyframes gradient-shift {
        0%,
        100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }
      @keyframes fade-in-up {
        from {
          opacity: 0;
          transform: translateY(40px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes scale-in {
        from {
          opacity: 0;
          transform: scale(0.95);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      @keyframes breathe {
        0%,
        100% {
          transform: scale(1);
          opacity: 0.5;
        }
        50% {
          transform: scale(1.05);
          opacity: 0.7;
        }
      }
      @keyframes glow-1 {
        0%,
        100% {
          opacity: 0.3;
          transform: translate(-50%, -50%) scale(1);
        }
        50% {
          opacity: 0.5;
          transform: translate(-50%, -50%) scale(1.2);
        }
      }
      @keyframes glow-2 {
        0%,
        100% {
          opacity: 0.2;
          transform: translate(-50%, -50%) scale(1.1);
        }
        50% {
          opacity: 0.4;
          transform: translate(-50%, -50%) scale(0.9);
        }
      }
      @keyframes glow-3 {
        0%,
        100% {
          opacity: 0.15;
          transform: translate(-50%, -50%) scale(0.9);
        }
        50% {
          opacity: 0.35;
          transform: translate(-50%, -50%) scale(1.15);
        }
      }
      @keyframes glow-4 {
        0%,
        100% {
          opacity: 0.25;
          transform: translate(-50%, -50%) scale(1.05);
        }
        50% {
          opacity: 0.45;
          transform: translate(-50%, -50%) scale(0.95);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.4;
        }
      }

      .animate-float {
        animation: float 8s ease-in-out infinite;
      }
      .animate-pulse-glow {
        animation: pulse-glow 6s ease-in-out infinite;
      }
      .animate-gradient {
        background-size: 200% 200%;
        animation: gradient-shift 8s ease infinite;
      }
      .animate-fade-in-up {
        animation: fade-in-up 0.8s ease-out forwards;
      }
      .animate-scale-in {
        animation: scale-in 0.6s ease-out forwards;
      }
      .animate-breathe {
        animation: breathe 4s ease-in-out infinite;
      }
      .animate-glow-1 {
        animation: glow-1 6s ease-in-out infinite;
      }
      .animate-glow-2 {
        animation: glow-2 8s ease-in-out infinite;
      }
      .animate-glow-3 {
        animation: glow-3 7s ease-in-out infinite;
      }
      .animate-glow-4 {
        animation: glow-4 5s ease-in-out infinite;
      }
      .delay-100 {
        animation-delay: 0.1s;
      }
      .delay-200 {
        animation-delay: 0.2s;
      }
      .delay-300 {
        animation-delay: 0.3s;
      }
      .delay-400 {
        animation-delay: 0.4s;
      }
      .delay-500 {
        animation-delay: 0.5s;
      }
      .delay-600 {
        animation-delay: 0.6s;
      }

      /* ═══ 渐变文字工具 ═══ */
      .text-gradient {
        background: var(--edge-gradient-1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .text-gradient-subtle {
        background: linear-gradient(135deg, var(--edge-primary) 0%, var(--edge-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .highlight {
        color: var(--edge-primary);
        font-weight: 600;
      }

      /* ═══ 章节标题系统（Apple HIG） ═══ */
      .section-kicker {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--edge-primary);
        margin-bottom: 12px;
      }
      .section-title {
        font-size: clamp(32px, 4.2vw, 48px);
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 18px;
        letter-spacing: -0.035em;
        color: var(--edge-text-primary);
      }
      .section-subtitle {
        font-size: 18px;
        font-weight: 400;
        color: var(--edge-text-secondary);
        max-width: 640px;
        line-height: 1.72;
        margin-bottom: 56px;
      }
      .section-inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
      }
      .edge-section {
        padding: 96px 0;
        background: var(--edge-bg-base);
      }
      .edge-section-alt {
        padding: 96px 0;
        background: var(--edge-bg-elevated);
      }
      .edge-section-dark {
        padding: 96px 0;
        background: #000;
        color: #e8e9f0;
      }

      /* ═══ Glass Card 系统（refined glassmorphism） ═══ */
      .glass-card {
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        border-radius: var(--edge-radius-lg);
        padding: 28px;
        transition:
          transform var(--edge-transition-base),
          box-shadow var(--edge-transition-base),
          border-color var(--edge-transition-base);
        position: relative;
        overflow: hidden;
      }
      .glass-card::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--edge-glass-highlight);
        pointer-events: none;
      }
      .glass-card:hover {
        transform: translateY(-3px) scale(1.006);
        box-shadow:
          var(--edge-glass-shadow-l3),
          0 0 48px -16px var(--edge-primary-glow);
        border-color: rgba(121, 150, 255, 0.18);
      }
      .glass-card > * {
        position: relative;
        z-index: 1;
      }

      /* ═══ Bento Grid ═══ */
      .bento-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 20px;
      }
      .bento-span-2 {
        grid-column: span 2;
      }
      .bento-span-3 {
        grid-column: span 3;
      }
      .bento-span-4 {
        grid-column: span 4;
      }
      .bento-span-6 {
        grid-column: span 6;
      }
      .bento-group-label {
        grid-column: span 6;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
      }
      .bento-group-label span {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--edge-text-tertiary);
        white-space: nowrap;
      }
      .bento-group-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--edge-border-strong), transparent);
      }
      .bento-card-title {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 8px;
        color: var(--edge-text-primary);
      }
      .bento-card-desc {
        font-size: 14px;
        color: var(--edge-text-secondary);
        line-height: 1.75;
      }
      .bento-intro {
        padding: 20px 24px;
      }
      .bento-intro .bento-card-desc {
        font-size: 15px;
      }

      /* ═══ 截图卡片 ═══ */
      .bento-screenshot {
        padding: 0;
        overflow: hidden;
      }
      .screenshot-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: var(--edge-bg-field);
      }
      .bento-span-2.bento-screenshot .screenshot-wrap {
        aspect-ratio: 4 / 5;
      }
      .screenshot-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform var(--edge-transition-slow);
      }
      .bento-screenshot:hover .screenshot-wrap img {
        transform: scale(1.02);
      }
      .screenshot-caption {
        padding: 14px 18px;
      }
      .screenshot-caption .bento-card-title {
        font-size: 15px;
        margin-bottom: 4px;
      }
      .screenshot-caption .bento-card-desc {
        font-size: 12px;
        line-height: 1.5;
      }

      /* ═══ 痛点 / 价值卡片 ═══ */
      .cards-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .icon-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .icon-card .card-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--edge-radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        flex-shrink: 0;
      }
      .icon-card .card-icon.red {
        background: var(--edge-error-subtle);
        border: 1px solid rgba(245, 81, 91, 0.18);
        color: var(--edge-error);
      }
      .icon-card .card-icon.green {
        background: var(--edge-success-subtle);
        border: 1px solid rgba(64, 214, 117, 0.18);
        color: var(--edge-success);
      }
      .icon-card .card-title {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .icon-card .card-title.red {
        color: var(--edge-error);
      }
      .icon-card .card-title.green {
        color: var(--edge-success);
      }
      .icon-card .card-desc {
        font-size: 14px;
        color: var(--edge-text-secondary);
        line-height: 1.7;
      }

      /* ═══ Apple 风格价值卡片 ═══ */
      .apple-value-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin: 32px 0;
      }
      .apple-value-card {
        padding: 28px 24px;
        text-align: center;
      }
      .apple-value-card .value-icon {
        font-size: 32px;
        margin-bottom: 14px;
        display: block;
      }
      .apple-value-card .value-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--edge-text-primary);
        margin-bottom: 8px;
        letter-spacing: -0.01em;
      }
      .apple-value-card .value-desc {
        font-size: 13px;
        color: var(--edge-text-secondary);
        line-height: 1.6;
      }

      /* ═══ 叙事标题 ═══ */
      .narrative-stage {
        margin: 56px 0 40px;
        text-align: center;
      }
      .narrative-stage-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--edge-text-tertiary);
        margin-bottom: 20px;
      }
      .narrative-stage-label::before,
      .narrative-stage-label::after {
        content: '';
        width: 32px;
        height: 1px;
        background: var(--edge-border-strong);
      }
      .narrative-stage-title {
        font-size: clamp(28px, 3.5vw, 40px);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--edge-text-primary);
        margin-bottom: 14px;
      }
      .narrative-stage-desc {
        font-size: 17px;
        line-height: 1.6;
        color: var(--edge-text-secondary);
        max-width: 680px;
        margin: 0 auto;
      }

      /* ═══ Hero Showcase（左右交替文本+图片） ═══ */
      .hero-showcase {
        position: relative;
        margin: 56px 0 48px;
        padding: 0;
        text-align: center;
      }
      .hero-showcase-text {
        max-width: 720px;
        margin: 0 auto 32px;
        padding: 0 24px;
      }
      .hero-showcase-eyebrow {
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--edge-primary);
        margin-bottom: 14px;
      }
      .hero-showcase-title {
        font-size: clamp(32px, 4.5vw, 52px);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.1;
        color: var(--edge-text-primary);
        margin-bottom: 16px;
      }
      .hero-showcase-subtitle {
        font-size: clamp(17px, 2vw, 21px);
        font-weight: 400;
        line-height: 1.5;
        color: var(--edge-text-secondary);
        letter-spacing: -0.01em;
      }
      .hero-showcase-image {
        position: relative;
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        border-radius: var(--edge-radius-xl);
        overflow: hidden;
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-border);
        box-shadow:
          0 24px 80px -24px rgba(0, 0, 0, 0.5),
          0 8px 24px -8px rgba(0, 0, 0, 0.3);
        aspect-ratio: 16 / 10;
      }
      .hero-showcase-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* ═══ 性能指标行 ═══ */
      .benchmark-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 48px;
      }
      .benchmark-card {
        text-align: center;
        padding: 32px 20px;
      }
      .benchmark-value {
        font-size: 40px;
        font-weight: 700;
        letter-spacing: -0.04em;
        font-variant-numeric: tabular-nums;
        background: var(--edge-gradient-1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 8px;
      }
      .benchmark-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--edge-text-tertiary);
        font-weight: 500;
      }

      /* ═══ 路线图 pill 行 ═══ */
      .shipped-pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin: 0 0 36px;
        padding: 18px 22px;
        border-radius: var(--edge-radius-md);
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        position: relative;
        overflow: hidden;
      }
      .shipped-pill-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--edge-text-tertiary);
        margin-right: 6px;
      }
      .shipped-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 100px;
        background: var(--edge-primary-subtle);
        border: 1px solid var(--edge-glass-border);
        color: var(--edge-text-secondary);
        transition: all var(--edge-transition-fast);
      }
      .shipped-pill:hover {
        border-color: rgba(121, 150, 255, 0.32);
        color: var(--edge-text-primary);
        transform: translateY(-1px);
      }
      .shipped-pill .pill-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--edge-success);
        animation: pulse 2.4s ease-in-out infinite;
      }

      /* ═══ Tech Stack Bar ═══ */
      .tech-stack-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        flex-wrap: wrap;
        padding: 16px 0;
        margin: 16px 0;
      }
      .tech-stack-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 600;
        color: var(--edge-text-secondary);
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-border);
        letter-spacing: -0.005em;
      }
      .tech-stack-item:first-child {
        border-radius: var(--edge-radius-sm) 0 0 var(--edge-radius-sm);
      }
      .tech-stack-item:last-child {
        border-radius: 0 var(--edge-radius-sm) var(--edge-radius-sm) 0;
      }
      .tech-stack-item + .tech-stack-item {
        border-left: none;
      }
      .tech-stack-item .ts-icon {
        font-size: 13px;
      }

      /* ═══ Stat Highlight ═══ */
      .stat-highlight-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin: 20px 0;
      }
      .stat-highlight-item {
        text-align: center;
        padding: 16px 8px;
      }
      .stat-highlight-item .stat-val {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.04em;
        background: var(--edge-gradient-1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 4px;
      }
      .stat-highlight-item .stat-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--edge-text-tertiary);
        font-weight: 500;
      }

      /* ═══ 三层架构图 ═══ */
