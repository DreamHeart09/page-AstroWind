---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'AIGov Insight Edge — AI-Native macOS 可观测平台',
  description: 'AI 原生、本地优先的 AI Agent 工作流可观测与治理平台。macOS 桌面端，AI Copilot 驱动 GUI 操控。',
};

const base = import.meta.env.BASE_URL;
---

<Layout metadata={metadata}>
  <div class="edge-page">
    <style>
      /* ════════════════════════════════════════════════════════════
         设计令牌 — Design Tokens（暗色为主，亮色可用）
         ════════════════════════════════════════════════════════════ */
      .edge-page {
        /* 亮色令牌（默认） */
        --edge-bg-base: #f2f2f7;
        --edge-bg-elevated: #ffffff;
        --edge-bg-surface: #fafafc;
        --edge-bg-field: #f5f5fa;
        --edge-text-primary: #1a1a24;
        --edge-text-secondary: #505068;
        --edge-text-tertiary: #8888a0;
        --edge-primary: #5068e0;
        --edge-primary-subtle: rgba(80, 104, 224, 0.1);
        --edge-primary-glow: rgba(80, 104, 224, 0.14);
        --edge-accent: #8b4fed;
        --edge-accent-subtle: rgba(139, 79, 237, 0.1);
        --edge-success: #2da855;
        --edge-success-subtle: rgba(45, 168, 85, 0.1);
        --edge-warning: #d4910a;
        --edge-error: #dc3545;
        --edge-error-subtle: rgba(220, 53, 69, 0.1);
        --edge-gradient-1: linear-gradient(135deg, #5068e0 0%, #8b4fed 100%);
        --edge-gradient-2: linear-gradient(135deg, #2da855 0%, #1a9bb8 100%);
        --edge-border: rgba(0, 0, 0, 0.06);
        --edge-border-strong: rgba(0, 0, 0, 0.1);
        --edge-glass-bg: rgba(255, 255, 255, 0.42);
        --edge-glass-border: rgba(0, 0, 0, 0.08);
        --edge-glass-bg-refined: rgba(255, 255, 255, 0.35);
        --edge-glass-highlight: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.7) 0%,
          rgba(255, 255, 255, 0.2) 40%,
          transparent 100%
        );
        --edge-glass-shadow-l2: 0 4px 16px rgba(0, 0, 0, 0.04);
        --edge-glass-shadow-l3: 0 12px 48px rgba(0, 0, 0, 0.08);
        --edge-glow-primary: 0 0 80px -24px rgba(80, 104, 224, 0.18);
        --edge-radius-sm: 8px;
        --edge-radius-md: 12px;
        --edge-radius-lg: 16px;
        --edge-radius-xl: 22px;
        --edge-transition-fast: 180ms cubic-bezier(0.22, 0.61, 0.36, 1);
        --edge-transition-base: 280ms cubic-bezier(0.22, 0.61, 0.36, 1);
        --edge-transition-slow: 450ms cubic-bezier(0.22, 0.61, 0.36, 1);
        color: var(--edge-text-primary);
      }

      :global(.dark) .edge-page {
        /* 暗色令牌 */
        --edge-bg-base: #08080c;
        --edge-bg-elevated: #0e0e14;
        --edge-bg-surface: #131318;
        --edge-bg-field: #16161e;
        --edge-text-primary: #e8e9f0;
        --edge-text-secondary: #a0a0b8;
        --edge-text-tertiary: #6e6e88;
        --edge-primary: #7996ff;
        --edge-primary-subtle: rgba(121, 150, 255, 0.1);
        --edge-primary-glow: rgba(121, 150, 255, 0.18);
        --edge-accent: #b98aff;
        --edge-accent-subtle: rgba(185, 138, 255, 0.1);
        --edge-success: #40d675;
        --edge-success-subtle: rgba(64, 214, 117, 0.1);
        --edge-warning: #f5ac37;
        --edge-error: #f5515b;
        --edge-error-subtle: rgba(245, 81, 91, 0.1);
        --edge-gradient-1: linear-gradient(135deg, #7996ff 0%, #b98aff 100%);
        --edge-gradient-2: linear-gradient(135deg, #40d675 0%, #3dc9e8 100%);
        --edge-border: rgba(255, 255, 255, 0.08);
        --edge-border-strong: rgba(255, 255, 255, 0.13);
        --edge-glass-bg: rgba(10, 10, 18, 0.52);
        --edge-glass-border: rgba(255, 255, 255, 0.08);
        --edge-glass-bg-refined: rgba(18, 18, 30, 0.72);
        --edge-glass-highlight: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.08) 0%,
          rgba(255, 255, 255, 0.02) 40%,
          transparent 100%
        );
        --edge-glass-shadow-l2: 0 4px 16px rgba(0, 0, 0, 0.08);
        --edge-glass-shadow-l3: 0 12px 48px rgba(0, 0, 0, 0.16);
        --edge-glow-primary: 0 0 80px -24px rgba(121, 150, 255, 0.28);
      }

      /* ═══ 动画 keyframes（保留 + 新增 carousel 过渡） ═══ */
      @keyframes float {
        0%,
        100% {
          transform: translateY(0px) rotate(0deg);
        }
        50% {
          transform: translateY(-30px) rotate(2deg);
        }
      }
      @keyframes pulse-glow {
        0%,
        100% {
          opacity: 0.4;
          transform: scale(1);
          filter: blur(60px);
        }
        50% {
          opacity: 0.7;
          transform: scale(1.1);
          filter: blur(80px);
        }
      }
      @keyframes gradient-shift {
        0%,
        100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }
      @keyframes fade-in-up {
        from {
          opacity: 0;
          transform: translateY(40px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes scale-in {
        from {
          opacity: 0;
          transform: scale(0.95);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      @keyframes orb-drift-1 {
        0% {
          transform: translate(0, 0) scale(1);
          opacity: 0.45;
        }
        25% {
          transform: translate(40px, -30px) scale(1.08);
          opacity: 0.6;
        }
        50% {
          transform: translate(-20px, -50px) scale(1.02);
          opacity: 0.5;
        }
        75% {
          transform: translate(30px, 20px) scale(1.1);
          opacity: 0.55;
        }
        100% {
          transform: translate(0, 0) scale(1);
          opacity: 0.45;
        }
      }
      @keyframes orb-drift-2 {
        0% {
          transform: translate(0, 0) scale(1);
          opacity: 0.35;
        }
        33% {
          transform: translate(-50px, 30px) scale(1.12);
          opacity: 0.5;
        }
        66% {
          transform: translate(30px, -40px) scale(0.95);
          opacity: 0.4;
        }
        100% {
          transform: translate(0, 0) scale(1);
          opacity: 0.35;
        }
      }
      @keyframes orb-drift-3 {
        0% {
          transform: translate(0, 0) scale(1);
          opacity: 0.3;
        }
        20% {
          transform: translate(25px, 40px) scale(1.06);
          opacity: 0.45;
        }
        50% {
          transform: translate(-35px, -20px) scale(1.1);
          opacity: 0.5;
        }
        80% {
          transform: translate(15px, -35px) scale(0.97);
          opacity: 0.35;
        }
        100% {
          transform: translate(0, 0) scale(1);
          opacity: 0.3;
        }
      }
      @keyframes orb-drift-4 {
        0% {
          transform: translate(0, 0) scale(1);
          opacity: 0.25;
        }
        40% {
          transform: translate(-30px, -45px) scale(1.15);
          opacity: 0.4;
        }
        70% {
          transform: translate(40px, 25px) scale(0.92);
          opacity: 0.35;
        }
        100% {
          transform: translate(0, 0) scale(1);
          opacity: 0.25;
        }
      }
      @keyframes glow-1 {
        0%,
        100% {
          opacity: 0.3;
          transform: translate(-50%, -50%) scale(1);
        }
        50% {
          opacity: 0.5;
          transform: translate(-50%, -50%) scale(1.2);
        }
      }
      @keyframes glow-2 {
        0%,
        100% {
          opacity: 0.2;
          transform: translate(-50%, -50%) scale(1.1);
        }
        50% {
          opacity: 0.4;
          transform: translate(-50%, -50%) scale(0.9);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.4;
        }
      }

      .animate-float {
        animation: float 8s ease-in-out infinite;
      }
      .animate-pulse-glow {
        animation: pulse-glow 6s ease-in-out infinite;
      }
      .animate-gradient {
        background-size: 200% 200%;
        animation: gradient-shift 8s ease infinite;
      }
      .animate-fade-in-up {
        animation: fade-in-up 0.8s ease-out forwards;
      }
      .animate-scale-in {
        animation: scale-in 0.6s ease-out forwards;
      }
      .animate-breathe {
        animation: orb-drift-1 12s ease-in-out infinite;
      }
      .animate-glow-1 {
        animation: glow-1 6s ease-in-out infinite;
      }
      .animate-glow-2 {
        animation: glow-2 8s ease-in-out infinite;
      }
      .delay-100 {
        animation-delay: 0.1s;
      }
      .delay-200 {
        animation-delay: 0.2s;
      }
      .delay-300 {
        animation-delay: 0.3s;
      }
      .delay-400 {
        animation-delay: 0.4s;
      }
      .delay-500 {
        animation-delay: 0.5s;
      }
      .delay-600 {
        animation-delay: 0.6s;
      }

      /* ═══ 渐变文字工具 ═══ */
      .text-gradient {
        background: var(--edge-gradient-1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .text-gradient-subtle {
        background: linear-gradient(135deg, var(--edge-primary) 0%, var(--edge-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .highlight {
        color: var(--edge-primary);
        font-weight: 600;
      }

      /* ═══ 章节标题系统（Apple HIG） ═══ */
      .section-kicker {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--edge-primary);
        margin-bottom: 12px;
      }
      .section-title {
        font-size: clamp(32px, 4.2vw, 48px);
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 18px;
        letter-spacing: -0.035em;
        color: var(--edge-text-primary);
      }
      .section-subtitle {
        font-size: 18px;
        font-weight: 400;
        color: var(--edge-text-secondary);
        max-width: 640px;
        line-height: 1.72;
        margin-bottom: 56px;
      }
      .section-inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
      }
      .edge-section {
        padding: 96px 0;
        background: var(--edge-bg-base);
      }
      .edge-section-alt {
        padding: 96px 0;
        background: var(--edge-bg-elevated);
      }
      .edge-section-dark {
        padding: 96px 0;
        background: #000;
        color: #e8e9f0;
      }
      .edge-section-dark .section-title {
        color: #e8e9f0;
      }
      .edge-section-dark .section-subtitle {
        color: #a0a0b8;
      }
      .edge-section-dark .section-kicker {
        color: #a0a0b8;
      }
      .edge-section-dark .text-gradient {
        background: linear-gradient(135deg, #7996ff 0%, #b98aff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .edge-section-dark .carousel-eyebrow {
        color: #7996ff;
      }
      .edge-section-dark .carousel-title {
        color: #e8e9f0;
      }
      .edge-section-dark .carousel-subtitle {
        color: #a0a0b8;
      }
      .edge-section-dark .carousel-arrow {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.15);
        color: #e8e9f0;
      }
      .edge-section-dark .carousel-arrow:hover {
        border-color: #7996ff;
        color: #7996ff;
      }
      .edge-section-dark .carousel-dot {
        background: rgba(255, 255, 255, 0.2);
      }
      .edge-section-dark .carousel-dot.is-active {
        background: linear-gradient(135deg, #7996ff 0%, #b98aff 100%);
      }

      /* ═══ Lightbox — Apple-style 弹出页 ═══ */
      .edge-lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 0 8px 0;
        pointer-events: none;
      }
      .edge-lightbox.is-open {
        pointer-events: auto;
      }
      .edge-lightbox-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        backdrop-filter: blur(20px) saturate(180%);
        opacity: 0;
        transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .edge-lightbox.is-open .edge-lightbox-backdrop {
        opacity: 1;
      }
      .edge-lightbox-card {
        position: relative;
        width: min(1080px, calc(100% - 16px));
        height: 88vh;
        margin-bottom: 0;
        border-radius: 20px 20px 0 0;
        overflow: hidden;
        background: #0e0e16;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-bottom: none;
        box-shadow:
          0 -1px 0 rgba(255, 255, 255, 0.04),
          0 -60px 120px -40px rgba(0, 0, 0, 0.6),
          0 -8px 60px -20px rgba(121, 150, 255, 0.06);
        transform: translateY(100%);
        transition: transform 0.42s cubic-bezier(0.32, 0.72, 0, 1);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .edge-lightbox.is-open .edge-lightbox-card {
        transform: translateY(0);
      }
      .edge-lightbox-image {
        position: relative;
        width: 100%;
        flex: 1 1 0;
        min-height: 0;
        overflow: hidden;
        background: #0a0a10;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .edge-lightbox-image img {
        display: block;
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        opacity: 0;
        transform: scale(1.02);
        transition:
          opacity 0.35s ease 0.12s,
          transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
      }
      .edge-lightbox.is-open .edge-lightbox-image img {
        opacity: 1;
        transform: scale(1);
      }
      .edge-lightbox-image::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 120px;
        background: linear-gradient(to top, #0e0e16, transparent);
        pointer-events: none;
      }
      .edge-lightbox-body {
        padding: 32px 48px 48px;
        opacity: 0;
        transform: translateY(10px);
        transition:
          opacity 0.3s ease 0.2s,
          transform 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
      }
      .edge-lightbox.is-open .edge-lightbox-body {
        opacity: 1;
        transform: translateY(0);
      }
      .edge-lightbox-eyebrow {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: #7996ff;
        margin-bottom: 12px;
      }
      .edge-lightbox-title {
        font-size: clamp(22px, 3vw, 30px);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.2;
        color: #e8e9f0;
        margin-bottom: 16px;
      }
      .edge-lightbox-desc {
        font-size: 16px;
        line-height: 1.75;
        color: #a0a0b8;
        max-width: 640px;
      }
      .edge-lightbox-close {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
        line-height: 1;
        z-index: 10;
        -webkit-backdrop-filter: blur(16px);
        backdrop-filter: blur(16px);
        opacity: 0;
        transition:
          opacity 0.25s ease 0.25s,
          background 0.2s ease,
          color 0.2s ease,
          transform 0.2s ease;
      }
      .edge-lightbox.is-open .edge-lightbox-close {
        opacity: 1;
      }
      .edge-lightbox-close:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        transform: scale(1.1);
      }

      /* ═══ Glass Card 系统（refined glassmorphism） ═══ */
      .glass-card {
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        border-radius: var(--edge-radius-lg);
        padding: 28px;
        transition:
          transform var(--edge-transition-base),
          box-shadow var(--edge-transition-base),
          border-color var(--edge-transition-base);
        position: relative;
        overflow: hidden;
      }
      .glass-card::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--edge-glass-highlight);
        pointer-events: none;
      }
      .glass-card:hover {
        transform: translateY(-3px) scale(1.006);
        box-shadow:
          var(--edge-glass-shadow-l3),
          0 0 48px -16px var(--edge-primary-glow);
        border-color: rgba(121, 150, 255, 0.18);
      }
      .glass-card > * {
        position: relative;
        z-index: 1;
      }

      /* ═══ Bento Grid ═══ */
      .bento-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 20px;
      }
      .bento-span-2 {
        grid-column: span 2;
      }
      .bento-span-3 {
        grid-column: span 3;
      }
      .bento-span-4 {
        grid-column: span 4;
      }
      .bento-span-5 {
        grid-column: span 5;
      }
      .bento-span-6 {
        grid-column: span 6;
      }
      .bento-group-label {
        grid-column: span 6;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
      }
      .bento-group-label span {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--edge-text-tertiary);
        white-space: nowrap;
      }
      .bento-group-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--edge-border-strong), transparent);
      }
      .bento-card-title {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 8px;
        color: var(--edge-text-primary);
      }
      .bento-card-desc {
        font-size: 14px;
        color: var(--edge-text-secondary);
        line-height: 1.75;
      }
      .bento-intro {
        padding: 20px 24px;
      }
      .bento-intro .bento-card-desc {
        font-size: 15px;
      }

      /* ═══ EverAgent 品牌专属 ═══ */
      .everagent-badge {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--edge-warning);
        background: rgba(245, 172, 55, 0.12);
        border: 1px solid rgba(245, 172, 55, 0.28);
        white-space: nowrap;
        margin-left: auto;
      }
      .everagent-plugin-card:hover {
        border-color: rgba(245, 172, 55, 0.32);
      }

      /* ═══ EverAgent 专门章节 ═══ */
      .everagent-hero {
        display: flex;
        align-items: center;
        gap: 24px;
        margin-bottom: 20px;
      }
      .everagent-hero-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        flex-shrink: 0;
        box-shadow: 0 4px 20px rgba(245, 172, 55, 0.25);
      }
      .everagent-hero-name {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--edge-text-primary);
      }
      .everagent-hero-sub {
        font-size: 13px;
        font-weight: 600;
        color: var(--edge-warning);
        margin-top: 4px;
        letter-spacing: 0.01em;
      }
      .everagent-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid var(--edge-border);
        font-size: 12px;
        color: var(--edge-text-tertiary);
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
      }
      .everagent-meta-dot {
        color: var(--edge-warning);
      }

      .everagent-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 0;
        flex-wrap: wrap;
        margin-top: 8px;
      }
      .everagent-flow-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        min-width: 120px;
        padding: 18px 14px;
        border-radius: var(--edge-radius-md);
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-glass-border);
        text-align: center;
        transition: all var(--edge-transition-fast);
        flex: 1;
      }
      .everagent-flow-step:hover {
        border-color: rgba(245, 172, 55, 0.32);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px -10px rgba(245, 172, 55, 0.2);
      }
      .everagent-flow-step .flow-emoji {
        font-size: 24px;
        line-height: 1;
      }
      .everagent-flow-step .flow-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--edge-text-primary);
        letter-spacing: -0.005em;
      }
      .everagent-flow-step .flow-sub {
        font-size: 11px;
        color: var(--edge-text-tertiary);
        line-height: 1.5;
      }
      .everagent-flow-arrow {
        font-size: 18px;
        color: var(--edge-warning);
        opacity: 0.55;
        align-self: center;
        padding: 0 6px;
      }
      .everagent-flow-footer {
        margin-top: 18px;
        font-size: 12px;
        color: var(--edge-text-tertiary);
        text-align: center;
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
        line-height: 1.7;
      }

      .everagent-capabilities {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }
      .everagent-capability {
        text-align: left;
      }
      .everagent-capability .cap-emoji {
        font-size: 22px;
        line-height: 1;
        margin-bottom: 12px;
        display: block;
      }
      .everagent-capability .cap-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--edge-text-primary);
        margin-bottom: 6px;
        letter-spacing: -0.01em;
      }
      .everagent-capability .cap-desc {
        font-size: 13px;
        color: var(--edge-text-secondary);
        line-height: 1.65;
      }

      .everagent-scenarios {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }
      .everagent-scenario {
        padding: 20px;
        border-radius: var(--edge-radius-md);
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        transition: all var(--edge-transition-fast);
      }
      .everagent-scenario:hover {
        border-color: rgba(245, 172, 55, 0.28);
        transform: translateY(-2px);
      }
      .everagent-scenario .scn-tag {
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--edge-warning);
        margin-bottom: 6px;
      }
      .everagent-scenario .scn-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--edge-text-primary);
        letter-spacing: -0.005em;
      }

      .everagent-cta {
        text-align: center;
        padding: 48px 32px;
        background:
          radial-gradient(circle at 50% 0%, rgba(245, 172, 55, 0.12) 0%, transparent 60%), var(--edge-glass-bg-refined);
        border: 1px solid rgba(245, 172, 55, 0.22);
      }
      .everagent-cta-title {
        font-size: clamp(24px, 2.6vw, 32px);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--edge-text-primary);
        margin-bottom: 10px;
      }
      .everagent-cta-sub {
        font-size: 14px;
        color: var(--edge-text-tertiary);
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
        margin-bottom: 28px;
      }
      .everagent-cta-buttons {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .everagent-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 28px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #d4910a 0%, #f5ac37 100%);
        border: 1px solid rgba(245, 172, 55, 0.5);
        box-shadow: 0 8px 24px -8px rgba(245, 172, 55, 0.5);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .everagent-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 32px -10px rgba(245, 172, 55, 0.6);
      }
      .everagent-btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 28px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 600;
        color: var(--edge-text-primary);
        background: var(--edge-glass-bg);
        border: 1px solid var(--edge-glass-border);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        transition: all var(--edge-transition-base);
      }
      .everagent-btn-secondary:hover {
        transform: translateY(-2px);
        border-color: var(--edge-warning);
      }

      @media (max-width: 900px) {
        .everagent-capabilities {
          grid-template-columns: repeat(2, 1fr);
        }
        .everagent-scenarios {
          grid-template-columns: repeat(2, 1fr);
        }
        .everagent-flow-step {
          min-width: 100px;
        }
      }
      @media (max-width: 600px) {
        .everagent-capabilities {
          grid-template-columns: 1fr;
        }
        .everagent-scenarios {
          grid-template-columns: 1fr;
        }
        .everagent-flow-arrow {
          transform: rotate(90deg);
          padding: 4px 0;
        }
        .everagent-hero {
          flex-direction: column;
          text-align: center;
          gap: 14px;
        }
      }

      /* ═══ 截图卡片 ═══ */
      .bento-screenshot {
        padding: 0;
        overflow: hidden;
      }
      .screenshot-wrap {
        position: relative;
        width: 100%;
        height: clamp(180px, 18vw, 280px);
        overflow: hidden;
        background: var(--edge-bg-field);
      }
      .screenshot-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform var(--edge-transition-slow);
      }
      .bento-screenshot:hover .screenshot-wrap img {
        transform: scale(1.02);
      }
      .screenshot-caption {
        padding: 14px 18px;
      }
      .screenshot-caption .bento-card-title {
        font-size: 15px;
        margin-bottom: 4px;
      }
      .screenshot-caption .bento-card-desc {
        font-size: 12px;
        line-height: 1.5;
      }

      /* ═══ 痛点 / 价值卡片 ═══ */
      .cards-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .icon-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .icon-card .card-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--edge-radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        flex-shrink: 0;
      }
      .icon-card .card-icon.red {
        background: var(--edge-error-subtle);
        border: 1px solid rgba(245, 81, 91, 0.18);
        color: var(--edge-error);
      }
      .icon-card .card-icon.green {
        background: var(--edge-success-subtle);
        border: 1px solid rgba(64, 214, 117, 0.18);
        color: var(--edge-success);
      }
      .icon-card .card-title {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .icon-card .card-title.red {
        color: var(--edge-error);
      }
      .icon-card .card-title.green {
        color: var(--edge-success);
      }
      .icon-card .card-desc {
        font-size: 14px;
        color: var(--edge-text-secondary);
        line-height: 1.7;
      }

      /* ═══ Apple 风格价值卡片 ═══ */
      .apple-value-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin: 32px 0;
      }
      .apple-value-card {
        padding: 28px 24px;
        text-align: center;
      }
      .apple-value-card .value-icon {
        font-size: 32px;
        margin-bottom: 14px;
        display: block;
      }
      .apple-value-card .value-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--edge-text-primary);
        margin-bottom: 8px;
        letter-spacing: -0.01em;
      }
      .apple-value-card .value-desc {
        font-size: 13px;
        color: var(--edge-text-secondary);
        line-height: 1.6;
      }

      /* ═══ 叙事标题 ═══ */
      .narrative-stage {
        margin: 56px 0 40px;
        text-align: center;
      }
      .narrative-stage-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--edge-text-tertiary);
        margin-bottom: 20px;
      }
      .narrative-stage-label::before,
      .narrative-stage-label::after {
        content: '';
        width: 32px;
        height: 1px;
        background: var(--edge-border-strong);
      }
      .narrative-stage-title {
        font-size: clamp(28px, 3.5vw, 40px);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--edge-text-primary);
        margin-bottom: 14px;
      }
      .narrative-stage-desc {
        font-size: 17px;
        line-height: 1.6;
        color: var(--edge-text-secondary);
        max-width: 680px;
        margin: 0 auto;
      }

      /* ═══ Hero Showcase（左右交替文本+图片） ═══ */
      .hero-showcase {
        position: relative;
        margin: 56px 0 48px;
        padding: 0;
        text-align: center;
      }
      .hero-showcase-text {
        max-width: 720px;
        margin: 0 auto 32px;
        padding: 0 24px;
      }
      .hero-showcase-eyebrow {
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--edge-primary);
        margin-bottom: 14px;
      }
      .hero-showcase-title {
        font-size: clamp(32px, 4.5vw, 52px);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.1;
        color: var(--edge-text-primary);
        margin-bottom: 16px;
      }
      .hero-showcase-subtitle {
        font-size: clamp(17px, 2vw, 21px);
        font-weight: 400;
        line-height: 1.5;
        color: var(--edge-text-secondary);
        letter-spacing: -0.01em;
      }
      .hero-showcase-image {
        position: relative;
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        border-radius: var(--edge-radius-xl);
        overflow: hidden;
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-border);
        box-shadow:
          0 24px 80px -24px rgba(0, 0, 0, 0.5),
          0 8px 24px -8px rgba(0, 0, 0, 0.3);
        aspect-ratio: 16 / 10;
      }
      .hero-showcase-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* ═══ 性能指标行 ═══ */
      .benchmark-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 48px;
      }
      .benchmark-card {
        text-align: center;
        padding: 32px 20px;
      }
      .benchmark-value {
        font-size: 40px;
        font-weight: 700;
        letter-spacing: -0.04em;
        font-variant-numeric: tabular-nums;
        background: var(--edge-gradient-1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 8px;
      }
      .benchmark-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--edge-text-tertiary);
        font-weight: 500;
      }

      /* ═══ 路线图 pill 行 ═══ */
      .shipped-pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin: 0 0 36px;
        padding: 18px 22px;
        border-radius: var(--edge-radius-md);
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        position: relative;
        overflow: hidden;
      }
      .shipped-pill-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--edge-text-tertiary);
        margin-right: 6px;
      }
      .shipped-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 100px;
        background: var(--edge-primary-subtle);
        border: 1px solid var(--edge-glass-border);
        color: var(--edge-text-secondary);
        transition: all var(--edge-transition-fast);
      }
      .shipped-pill:hover {
        border-color: rgba(121, 150, 255, 0.32);
        color: var(--edge-text-primary);
        transform: translateY(-1px);
      }
      .shipped-pill .pill-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--edge-success);
        animation: pulse 2.4s ease-in-out infinite;
      }

      /* ═══ Tech Stack Bar ═══ */
      .tech-stack-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        flex-wrap: wrap;
        padding: 16px 0;
        margin: 16px 0;
      }
      .tech-stack-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 600;
        color: var(--edge-text-secondary);
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-border);
        letter-spacing: -0.005em;
      }
      .tech-stack-item:first-child {
        border-radius: var(--edge-radius-sm) 0 0 var(--edge-radius-sm);
      }
      .tech-stack-item:last-child {
        border-radius: 0 var(--edge-radius-sm) var(--edge-radius-sm) 0;
      }
      .tech-stack-item + .tech-stack-item {
        border-left: none;
      }
      .tech-stack-item .ts-icon {
        font-size: 13px;
      }

      /* ═══ Stat Highlight ═══ */
      .stat-highlight-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin: 20px 0;
      }
      .stat-highlight-item {
        text-align: center;
        padding: 16px 8px;
      }
      .stat-highlight-item .stat-val {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.04em;
        background: var(--edge-gradient-1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 4px;
      }
      .stat-highlight-item .stat-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--edge-text-tertiary);
        font-weight: 500;
      }

      /* ═══ 三层架构图 ═══ */
      .arch-layer-collection {
        border: 1px dashed var(--edge-border-strong);
        border-radius: var(--edge-radius-lg);
        padding: 24px;
        margin-bottom: 12px;
        background: var(--edge-glass-bg-refined);
      }
      .arch-layer-label {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.01em;
        color: var(--edge-text-primary);
      }
      .arch-layer-label .layer-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
      }
      .arch-layer-label .layer-dot.blue {
        background: var(--edge-primary);
      }
      .arch-layer-label .layer-dot.purple {
        background: var(--edge-accent);
      }
      .arch-layer-label .layer-dot.green {
        background: var(--edge-success);
      }
      .arch-nodes {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
      }
      .arch-node {
        padding: 12px 20px;
        border-radius: var(--edge-radius-sm);
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        border: 1px solid var(--edge-glass-border);
        background: var(--edge-bg-field);
        transition: all var(--edge-transition-fast);
        min-width: 120px;
      }
      .arch-node:hover {
        border-color: var(--edge-primary);
        box-shadow: var(--edge-glow-primary);
      }
      .arch-node .node-label {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--edge-text-primary);
      }
      .arch-node .node-sub {
        font-size: 10px;
        color: var(--edge-text-tertiary);
        margin-top: 2px;
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
      }
      .arch-node.everagent-node {
        border-color: rgba(245, 172, 55, 0.35);
      }
      .arch-node.everagent-node:hover {
        border-color: var(--edge-warning);
        box-shadow: 0 0 80px -24px rgba(245, 172, 55, 0.45);
      }
      .everagent-node-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
      }
      .everagent-node-label img {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        display: block;
      }
      .arch-arrow-down {
        display: flex;
        justify-content: center;
        padding: 6px 0;
      }
      .arch-arrow-down .arrow-line {
        width: 1px;
        height: 24px;
        background: var(--edge-gradient-1);
        position: relative;
      }
      .arch-arrow-down .arrow-line::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 4px solid transparent;
        border-right: 4px solid transparent;
        border-top: 6px solid var(--edge-accent);
      }

      /* ═══ ReAct Loop 流程图 ═══ */
      .copilot-flow {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 0;
        flex-wrap: wrap;
        padding: 8px 0 0;
      }
      .copilot-flow-step {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 130px;
        padding: 16px 14px;
        border-radius: var(--edge-radius-md);
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-glass-border);
        text-align: center;
        transition: all var(--edge-transition-fast);
      }
      .copilot-flow-step:hover {
        border-color: rgba(121, 150, 255, 0.32);
        transform: translateY(-2px);
        box-shadow: var(--edge-glow-primary);
      }
      .copilot-flow-step .step-num {
        position: absolute;
        top: -8px;
        left: -8px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--edge-gradient-1);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .copilot-flow-step .step-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--edge-text-primary);
        letter-spacing: -0.005em;
      }
      .copilot-flow-step .step-sub {
        font-size: 10px;
        color: var(--edge-text-tertiary);
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
      }
      .flow-arrow {
        font-size: 16px;
        color: var(--edge-primary);
        padding: 0 6px;
        opacity: 0.5;
        align-self: center;
      }

      /* ═══ Hero 专属 ═══ */
      .hero-badge {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }
      :global(.dark) .hero-badge {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.6) 100%);
      }
      .hero-button-primary {
        background: linear-gradient(135deg, #6c8cff 0%, #a78bfa 50%, #c084fc 100%);
        background-size: 200% 200%;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .hero-button-primary:hover {
        background-position: 100% 50%;
        transform: translateY(-2px);
        box-shadow: 0 20px 40px -12px rgba(108, 140, 255, 0.4);
      }
      .hero-button-secondary {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      :global(.dark) .hero-button-secondary {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.5) 100%);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(108, 140, 255, 0.2);
        box-shadow:
          0 4px 24px rgba(0, 0, 0, 0.3),
          inset 0 1px 0 rgba(255, 255, 255, 0.05);
      }
      .hero-button-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.15);
      }
      :global(.dark) .hero-button-secondary:hover {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.85) 0%, rgba(15, 23, 42, 0.7) 100%);
        border-color: rgba(108, 140, 255, 0.4);
        box-shadow:
          0 8px 32px rgba(0, 0, 0, 0.4),
          0 0 40px rgba(108, 140, 255, 0.15),
          inset 0 1px 0 rgba(255, 255, 255, 0.08);
      }
      .glow-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        will-change: transform, opacity;
      }
      .glow-orb--indigo {
        background: radial-gradient(circle, rgba(99, 102, 241, 0.35) 0%, rgba(99, 102, 241, 0.08) 50%, transparent 70%);
      }
      .glow-orb--purple {
        background: radial-gradient(circle, rgba(139, 92, 246, 0.3) 0%, rgba(139, 92, 246, 0.06) 50%, transparent 70%);
      }
      .glow-orb--violet {
        background: radial-gradient(circle, rgba(124, 58, 237, 0.25) 0%, rgba(124, 58, 237, 0.05) 50%, transparent 70%);
      }
      .glow-orb--blue {
        background: radial-gradient(circle, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.04) 50%, transparent 70%);
      }
      :global(.dark) .glow-orb--indigo {
        background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, rgba(99, 102, 241, 0.06) 50%, transparent 70%);
      }
      :global(.dark) .glow-orb--purple {
        background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, rgba(139, 92, 246, 0.04) 50%, transparent 70%);
      }
      :global(.dark) .glow-orb--violet {
        background: radial-gradient(circle, rgba(124, 58, 237, 0.18) 0%, rgba(124, 58, 237, 0.03) 50%, transparent 70%);
      }
      :global(.dark) .glow-orb--blue {
        background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, rgba(59, 130, 246, 0.03) 50%, transparent 70%);
      }
      .glow-orb-1 {
        animation: orb-drift-1 14s ease-in-out infinite;
      }
      .glow-orb-2 {
        animation: orb-drift-2 18s ease-in-out infinite;
      }
      .glow-orb-3 {
        animation: orb-drift-3 16s ease-in-out infinite;
      }
      .glow-orb-4 {
        animation: orb-drift-4 20s ease-in-out infinite;
      }
      .glow-orb-5 {
        animation: orb-drift-2 22s ease-in-out infinite reverse;
      }
      .metric-card-hero {
        text-align: center;
        padding: 1.5rem 1rem;
        border-radius: 1rem;
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      /* ═══ Mac Window 截图框 ═══ */
      .mac-window {
        border-radius: 12px;
        overflow: hidden;
        box-shadow:
          0 0 0 1px rgba(0, 0, 0, 0.08),
          0 20px 60px -12px rgba(0, 0, 0, 0.2),
          0 0 120px -40px rgba(108, 140, 255, 0.15);
        transition:
          transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
          box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      }
      :global(.dark) .mac-window {
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.06),
          0 20px 60px -12px rgba(0, 0, 0, 0.5),
          0 0 120px -40px rgba(108, 140, 255, 0.2);
      }
      .mac-window:hover {
        transform: scale(1.01);
      }
      .mac-titlebar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        background: rgba(245, 245, 247, 0.95);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      }
      :global(.dark) .mac-titlebar {
        background: rgba(30, 30, 42, 0.95);
        border-bottom-color: rgba(255, 255, 255, 0.06);
      }
      .mac-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
      }

      /* ═══ 插件卡片 ═══ */
      .plugin-card {
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        border-radius: var(--edge-radius-lg);
        padding: 2rem;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .plugin-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--edge-glass-shadow-l3);
      }

      /* ═══ Carousel 轮播组件 ═══ */
      .carousel {
        position: relative;
        margin: 32px 0 48px;
      }
      .carousel-track {
        position: relative;
      }
      .carousel-slide {
        opacity: 0;
        position: absolute;
        inset: 0;
        transform: translateX(24px);
        transition:
          opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }
      .carousel-slide.is-active {
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
      }
      .carousel-slide-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: center;
      }
      .carousel-slide-inner.reverse .carousel-text {
        order: 2;
      }
      .carousel-text {
        max-width: 480px;
      }
      .carousel-eyebrow {
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--edge-primary);
        margin-bottom: 14px;
      }
      .carousel-title {
        font-size: clamp(26px, 3vw, 36px);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--edge-text-primary);
        margin-bottom: 14px;
      }
      .carousel-subtitle {
        font-size: 16px;
        line-height: 1.6;
        color: var(--edge-text-secondary);
      }
      .carousel-image {
        position: relative;
      }
      .carousel-screenshot {
        border-radius: var(--edge-radius-lg);
        box-shadow: var(--edge-glass-shadow-l3);
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .carousel-image {
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: var(--edge-radius-lg);
      }
      .carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        color: var(--edge-text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 22px;
        line-height: 1;
        z-index: 10;
        transition: all var(--edge-transition-fast);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .carousel-arrow:hover {
        border-color: var(--edge-primary);
        color: var(--edge-primary);
        box-shadow: var(--edge-glow-primary);
      }
      .carousel-arrow.prev {
        left: -28px;
      }
      .carousel-arrow.next {
        right: -28px;
      }
      .carousel-dots {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 24px;
      }
      .carousel-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--edge-border-strong);
        border: none;
        cursor: pointer;
        padding: 0;
        transition: all var(--edge-transition-fast);
      }
      .carousel-dot.is-active {
        width: 24px;
        border-radius: 4px;
        background: var(--edge-gradient-1);
      }

      /* ═══ Highlights 产品亮点网格 ═══ */
      .highlights-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .highlight-card {
        border-radius: var(--edge-radius-lg);
        overflow: hidden;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition:
          transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
          box-shadow 0.4s ease;
        cursor: pointer;
      }
      .highlight-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.5);
      }
      .highlight-img {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: #0a0a10;
      }
      .highlight-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .highlight-card:hover .highlight-img img {
        transform: scale(1.03);
      }
      .highlight-img::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 60px;
        background: linear-gradient(to top, rgba(14, 14, 22, 1), transparent);
        pointer-events: none;
      }
      .highlight-body {
        padding: 20px 24px 24px;
      }
      .highlight-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #7996ff;
        margin-bottom: 8px;
      }
      .highlight-title {
        font-size: 18px;
        font-weight: 700;
        color: #e8e9f0;
        margin-bottom: 6px;
        letter-spacing: -0.01em;
      }
      .highlight-desc {
        font-size: 13px;
        color: #6e6e88;
        line-height: 1.5;
      }

      /* ═══ reveal 滚动动画 ═══ */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition:
          opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* ═══ 响应式 ═══ */
      /* ═══ Security Pipeline 五层纵深分析 ═══ */
      .security-pipeline {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        margin: 40px 0;
      }
      .pipeline-entry-group {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin-bottom: 8px;
      }
      .pipeline-entry-card {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        border-radius: var(--edge-radius-md);
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        font-size: 13px;
        font-weight: 600;
        color: var(--edge-text-primary);
        transition: all var(--edge-transition-fast);
      }
      .pipeline-entry-card:hover {
        border-color: rgba(121, 150, 255, 0.25);
        transform: translateY(-2px);
        box-shadow: var(--edge-glow-primary);
      }
      .pipeline-entry-card .entry-icon {
        font-size: 18px;
      }
      .pipeline-entry-card .entry-sub {
        font-size: 11px;
        color: var(--edge-text-tertiary);
        font-weight: 400;
      }
      .pipeline-connector-line {
        width: 2px;
        height: 28px;
        background: linear-gradient(to bottom, var(--edge-primary), var(--edge-accent));
        opacity: 0.4;
        position: relative;
      }
      .pipeline-connector-line::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 50%;
        transform: translateX(-50%);
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 6px solid var(--edge-accent);
        opacity: 0.6;
      }
      .pipeline-connector-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--edge-text-tertiary);
        margin: 4px 0;
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
      }
      .pipeline-layer-card {
        width: 100%;
        max-width: 720px;
        padding: 24px 28px;
        border-radius: var(--edge-radius-lg);
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        position: relative;
        overflow: hidden;
        transition: all var(--edge-transition-base);
      }
      .pipeline-layer-card::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--edge-glass-highlight);
        pointer-events: none;
      }
      .pipeline-layer-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--edge-glass-shadow-l3);
        border-color: rgba(121, 150, 255, 0.2);
      }
      .pipeline-layer-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 14px;
        position: relative;
        z-index: 1;
      }
      .pipeline-layer-badge {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 12px;
        border-radius: var(--edge-radius-sm);
        background: var(--edge-primary-subtle);
        border: 1px solid rgba(121, 150, 255, 0.15);
        flex-shrink: 0;
      }
      .pipeline-layer-badge .badge-num {
        font-size: 14px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--edge-primary);
        line-height: 1;
      }
      .pipeline-layer-badge .badge-time {
        font-size: 9px;
        font-weight: 600;
        color: var(--edge-text-tertiary);
        margin-top: 2px;
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
      }
      .pipeline-layer-icon {
        font-size: 24px;
        flex-shrink: 0;
      }
      .pipeline-layer-info {
        flex: 1;
        min-width: 0;
      }
      .pipeline-layer-title {
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--edge-text-primary);
        margin-bottom: 2px;
      }
      .pipeline-layer-subtitle {
        font-size: 13px;
        color: var(--edge-text-secondary);
      }
      .pipeline-layer-tag {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 100px;
        flex-shrink: 0;
      }
      .pipeline-layer-tag.tag-fast {
        background: var(--edge-success-subtle);
        color: var(--edge-success);
        border: 1px solid rgba(64, 214, 117, 0.2);
      }
      .pipeline-layer-tag.tag-ai {
        background: var(--edge-accent-subtle);
        color: var(--edge-accent);
        border: 1px solid rgba(185, 138, 255, 0.2);
      }
      .pipeline-layer-tag.tag-deep {
        background: var(--edge-primary-subtle);
        color: var(--edge-primary);
        border: 1px solid rgba(121, 150, 255, 0.2);
      }
      .pipeline-layer-tag.tag-logic {
        background: var(--edge-error-subtle);
        color: var(--edge-error);
        border: 1px solid rgba(245, 81, 91, 0.2);
      }
      .pipeline-layer-tag.tag-score {
        background: linear-gradient(135deg, var(--edge-primary-subtle), var(--edge-accent-subtle));
        color: var(--edge-primary);
        border: 1px solid rgba(121, 150, 255, 0.15);
      }
      .pipeline-layer-body {
        position: relative;
        z-index: 1;
      }
      .pipeline-detail-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .pipeline-detail-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 500;
        padding: 5px 12px;
        border-radius: 100px;
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-border);
        color: var(--edge-text-secondary);
      }
      .pipeline-detail-pill .pill-emoji {
        font-size: 13px;
      }
      .pipeline-output-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: var(--edge-radius-sm);
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-border);
        color: var(--edge-text-secondary);
        margin-top: 12px;
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
        position: relative;
        z-index: 1;
      }
      .pipeline-output-tag .out-label {
        color: var(--edge-primary);
        font-weight: 700;
      }
      /* Scoring bars */
      .scoring-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .scoring-row {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .scoring-bar-track {
        flex: 1;
        height: 6px;
        border-radius: 3px;
        background: var(--edge-bg-field);
        overflow: hidden;
      }
      .scoring-bar-fill {
        height: 100%;
        border-radius: 3px;
        background: var(--edge-gradient-1);
        transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .scoring-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--edge-text-primary);
        min-width: 72px;
      }
      .scoring-detail {
        font-size: 11px;
        color: var(--edge-text-tertiary);
        min-width: 140px;
        text-align: right;
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
      }
      /* Decision diamond */
      .pipeline-decision-card {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 16px 24px;
        margin: 8px 0;
      }
      .decision-diamond-visual {
        width: 48px;
        height: 48px;
        transform: rotate(45deg);
        border: 2px solid var(--edge-warning);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: rgba(245, 172, 55, 0.06);
      }
      .decision-diamond-visual .diamond-text {
        transform: rotate(-45deg);
        font-size: 11px;
        font-weight: 700;
        color: var(--edge-warning);
        text-align: center;
        line-height: 1.2;
      }
      .decision-branches {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }
      .decision-branch-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: var(--edge-radius-sm);
        font-size: 12px;
        font-weight: 600;
      }
      .decision-branch-item.branch-yes {
        background: var(--edge-success-subtle);
        border: 1px solid rgba(64, 214, 117, 0.2);
        color: var(--edge-success);
      }
      .decision-branch-item.branch-no {
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-border);
        color: var(--edge-text-secondary);
      }
      .decision-branch-item.branch-danger {
        background: var(--edge-error-subtle);
        border: 1px solid rgba(245, 81, 91, 0.2);
        color: var(--edge-error);
      }
      .decision-branch-item.branch-safe {
        background: var(--edge-success-subtle);
        border: 1px solid rgba(64, 214, 117, 0.2);
        color: var(--edge-success);
      }
      .decision-branch-item.branch-condition {
        background: var(--edge-warning ? rgba(245, 172, 55, 0.08): var(--edge-bg-field));
        border: 1px solid rgba(245, 172, 55, 0.2);
        color: var(--edge-warning);
      }
      .decision-branch-item .branch-sub {
        font-size: 10px;
        font-weight: 400;
        opacity: 0.8;
      }
      /* Output cards */
      .pipeline-output-group {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin-top: 8px;
      }
      .pipeline-output-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 16px 24px;
        border-radius: var(--edge-radius-md);
        background: var(--edge-glass-bg-refined);
        border: 1px solid var(--edge-glass-border);
        text-align: center;
        transition: all var(--edge-transition-fast);
        min-width: 120px;
      }
      .pipeline-output-card:hover {
        border-color: rgba(64, 214, 117, 0.3);
        transform: translateY(-2px);
        box-shadow: 0 0 40px -16px rgba(64, 214, 117, 0.2);
      }
      .pipeline-output-card .out-icon {
        font-size: 22px;
      }
      .pipeline-output-card .out-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--edge-text-primary);
      }
      .pipeline-output-card .out-sub {
        font-size: 11px;
        color: var(--edge-text-tertiary);
      }

      /* ═══ Feature Pill 行 ═══ */
      .feature-pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
      }
      .feature-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 100px;
        background: var(--edge-bg-field);
        border: 1px solid var(--edge-border);
        color: var(--edge-text-secondary);
        font-family: 'SF Mono', 'JetBrains Mono', monospace;
      }
      .feature-pill .pill-severity {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
      }
      .feature-pill .pill-severity.sev-critical {
        background: var(--edge-error);
      }
      .feature-pill .pill-severity.sev-high {
        background: var(--edge-warning);
      }
      .feature-pill .pill-severity.sev-info {
        background: var(--edge-success);
      }

      /* ═══ Security 威胁类型网格（5列） ═══ */
      .threat-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin: 32px 0;
      }
      .threat-card {
        text-align: center;
        padding: 24px 16px;
      }
      .threat-card .threat-icon {
        font-size: 28px;
        margin-bottom: 12px;
        display: block;
      }
      .threat-card .threat-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--edge-text-primary);
        margin-bottom: 6px;
        letter-spacing: -0.01em;
      }
      .threat-card .threat-count {
        font-size: 12px;
        color: var(--edge-text-secondary);
        line-height: 1.5;
      }

      @media (max-width: 1024px) {
        .apple-value-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .threat-grid {
          grid-template-columns: repeat(3, 1fr);
        }
        .pipeline-entry-group {
          flex-wrap: wrap;
        }
        .pipeline-layer-card {
          max-width: 100%;
        }
        .pipeline-decision-card {
          flex-direction: column;
        }
        .pipeline-output-group {
          flex-wrap: wrap;
        }
        .scoring-row {
          flex-wrap: wrap;
        }
        .scoring-detail {
          min-width: auto;
        }
        .bento-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .bento-span-1,
        .bento-span-2,
        .bento-span-3,
        .bento-span-4,
        .bento-span-5 {
          grid-column: span 2;
        }
        .bento-span-6 {
          grid-column: span 2;
        }
        .bento-group-label {
          grid-column: span 2;
        }
        .carousel-slide-inner {
          grid-template-columns: 1fr;
          gap: 24px;
        }
        .carousel-slide-inner.reverse .carousel-text {
          order: 0;
        }
        .stat-highlight-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 640px) {
        .apple-value-grid {
